rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================================================
    // 1. SHARED WORKSPACE ACCESS
    // ==================================================

    function hasFullWorkspaceAccess(workspaceUid, memberUid) {
      let memberPath =
        /databases/$(database)/documents/users/$(workspaceUid)/workspaceMembers/$(memberUid);
      let member = get(memberPath).data;
      return member.uid == memberUid
        && member.status == 'active'
        && member.role == 'full_access';
    }

    function isWorkspaceMember(userId) {
      return request.auth != null
        && (request.auth.uid == userId || hasFullWorkspaceAccess(userId, request.auth.uid));
    }

    // Keep the existing function name so all existing business-data matchers
    // inherit shared-workspace membership without changing document paths.
    function isOwner(userId) {
      return isWorkspaceMember(userId);
    }

    function createdByCurrentActor(data) {
      return request.auth != null
        && data.createdBy is string
        && data.createdBy == request.auth.uid;
    }

    // Temporary restore mode is scoped to the existing workspace namespace,
    // not to whichever member happens to be signed in.
    function isRestoreMode(userId) {
      let restorePath =
        /databases/$(database)/documents/users/$(userId)/system/restoreMode;
      return isWorkspaceMember(userId)
        && exists(restorePath)
        && get(restorePath).data.active == true
        && get(restorePath).data.ownerUid == userId
        && get(restorePath).data.sessionToken is string
        && get(restorePath).data.sessionToken.size() >= 32
        && get(restorePath).data.expiresAt is timestamp
        && get(restorePath).data.expiresAt > request.time;
    }

    function validWorkspaceMember(uid, data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'role', 'status', 'invitationId',
          'invitedBy', 'invitedByEmail', 'isWorkspaceOwner', 'joinedAt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'status', 'invitationId',
          'invitedBy', 'invitedByEmail', 'isWorkspaceOwner', 'joinedAt', 'createdAt',
          'revokedBy', 'revokedAt'
        ])
        && data.uid == uid
        && data.email is string
        && data.email.size() > 2
        && data.email.size() <= 254
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.role == 'full_access'
        && data.status in ['active', 'revoked']
        && data.invitationId is string
        && data.invitedBy is string
        && data.invitedByEmail is string
        && data.isWorkspaceOwner is bool
        && data.joinedAt is timestamp
        && data.createdAt is timestamp
        && (!('revokedBy' in data) || data.revokedBy is string)
        && (!('revokedAt' in data) || data.revokedAt is timestamp);
    }

    function validInvitationCreate(userId, invitationId, data) {
      return data.keys().hasAll([
          'invitationId', 'workspaceUid', 'invitedEmail', 'status',
          'createdBy', 'createdByEmail', 'createdAt', 'expiresAt'
        ])
        && data.keys().hasOnly([
          'invitationId', 'workspaceUid', 'invitedEmail', 'status',
          'createdBy', 'createdByEmail', 'createdAt', 'expiresAt'
        ])
        && data.invitationId == invitationId
        && invitationId.matches('^[a-f0-9]{64}$')
        && data.workspaceUid == userId
        && data.invitedEmail is string
        && data.invitedEmail.size() <= 254
        && data.invitedEmail.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.status == 'pending'
        && data.createdBy == request.auth.uid
        && request.auth.token.email is string
        && data.createdByEmail == request.auth.token.email.lower()
        && data.createdAt is timestamp
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(8, 'd');
    }

    function validInvitationAcceptance(userId, invitationId, invitation) {
      let memberPath =
        /databases/$(database)/documents/users/$(userId)/workspaceMembers/$(request.auth.uid);
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower() == invitation.invitedEmail
        && invitation.status == 'pending'
        && invitation.workspaceUid == userId
        && invitation.expiresAt is timestamp
        && invitation.expiresAt > request.time
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.acceptedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
        && existsAfter(memberPath)
        && getAfter(memberPath).data.uid == request.auth.uid
        && getAfter(memberPath).data.email == invitation.invitedEmail
        && getAfter(memberPath).data.status == 'active'
        && getAfter(memberPath).data.role == 'full_access'
        && getAfter(memberPath).data.invitationId == invitationId
        && getAfter(memberPath).data.invitedBy == invitation.createdBy
        && getAfter(memberPath).data.invitedByEmail == invitation.createdByEmail;
    }

    // ==================================================
    // 2. PROPERTY VALIDATION
    // ==================================================

    function validProperty(data) {
      return data.keys().hasAll([
          'name',
          'propertyCode',
          'normalizedName',
          'address',
          'notes',
          'status',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'name',
          'propertyCode',
          'normalizedName',
          'address',
          'notes',
          'status',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 100
        && data.propertyCode is string
        && data.propertyCode.matches('^P[0-9]{2}$')
        && data.propertyCode != 'P00'
        && data.normalizedName is string
        && data.normalizedName.size() >= 1
        && data.normalizedName.size() <= 100
        && data.address is string
        && data.address.size() <= 240
        && data.notes is string
        && data.notes.size() <= 1000
        && data.status == 'active'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid;
    }

    function validNameIndex(data) {
      return data.keys().hasAll([
          'propertyId',
          'normalizedName',
          'displayName',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'propertyId',
          'normalizedName',
          'displayName',
          'createdAt',
          'updatedAt'
        ])
        && data.propertyId is string
        && data.propertyId.size() > 0
        && data.normalizedName is string
        && data.normalizedName.size() >= 1
        && data.normalizedName.size() <= 100
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ==================================================
    // 3. TENANT VALIDATION
    // ==================================================

    function validTenant(data) {
      return data.keys().hasAll([
          'tenantCode',
          'fullName',
          'phone',
          'email',
          'address',
          'notes',
          'status',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'tenantCode',
          'fullName',
          'phone',
          'email',
          'address',
          'notes',
          'status',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.tenantCode is string
        && data.tenantCode.matches('^T[0-9]{5}[A-Z]$')
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 100
        && data.phone is string
        && data.phone.size() >= 7
        && data.phone.size() <= 20
        && data.phone.matches('^[+0-9() -]{7,20}$')
        && data.phone.matches('.*[0-9].*[0-9].*[0-9].*[0-9].*[0-9].*[0-9].*[0-9].*')
        && data.email is string
        && data.email.size() <= 254
        && data.address is string
        && data.address.size() <= 240
        && data.notes is string
        && data.notes.size() <= 1000
        && data.status in ['active', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid;
    }

    // ==================================================
    // 4. ROOM / PROPERTY VALIDATION
    // ==================================================

    function roomPropertyIsActive(userId, data) {
      return data.propertyId is string
        && data.propertyCode is string
        && data.propertyCode.matches('^P[0-9]{2}$')
        && exists(
          /databases/$(database)/documents/users/$(userId)/properties/$(data.propertyId)
        )
        && get(
          /databases/$(database)/documents/users/$(userId)/properties/$(data.propertyId)
        ).data.propertyCode == data.propertyCode
        && get(
          /databases/$(database)/documents/users/$(userId)/properties/$(data.propertyId)
        ).data.status == 'active';
    }

    function validRoom(data, userId) {
      return data.keys().hasAll([
          'roomCode',
          'propertyId',
          'propertyCode',
          'floorName',
          'roomNumber',
          'normalizedFloorName',
          'normalizedRoomNumber',
          'notes',
          'status',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'roomCode',
          'propertyId',
          'propertyCode',
          'floorName',
          'roomNumber',
          'normalizedFloorName',
          'normalizedRoomNumber',
          'notes',
          'status',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.roomCode is string
        && data.roomCode.matches('^R[0-9]{4}$')
        && data.roomCode != 'R0000'
        && data.propertyId is string
        && data.propertyId.size() > 0
        && data.propertyCode is string
        && data.propertyCode.matches('^P[0-9]{2}$')
        && data.floorName is string
        && data.floorName.size() >= 1
        && data.floorName.size() <= 80
        && data.roomNumber is string
        && data.roomNumber.size() >= 1
        && data.roomNumber.size() <= 30
        && data.normalizedFloorName is string
        && data.normalizedFloorName.size() >= 1
        && data.normalizedFloorName.size() <= 80
        && data.normalizedRoomNumber is string
        && data.normalizedRoomNumber.size() >= 1
        && data.normalizedRoomNumber.size() <= 30
        && data.notes is string
        && data.notes.size() <= 1000
        && data.status in ['vacant', 'maintenance', 'inactive']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid
        && roomPropertyIsActive(userId, data);
    }

    function validRoomNameIndex(data) {
      return data.keys().hasAll([
          'roomId',
          'propertyId',
          'normalizedFloorName',
          'normalizedRoomNumber',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'roomId',
          'propertyId',
          'normalizedFloorName',
          'normalizedRoomNumber',
          'createdAt',
          'updatedAt'
        ])
        && data.roomId is string
        && data.roomId.size() > 0
        && data.propertyId is string
        && data.propertyId.size() > 0
        && data.normalizedFloorName is string
        && data.normalizedFloorName.size() >= 1
        && data.normalizedFloorName.size() <= 80
        && data.normalizedRoomNumber is string
        && data.normalizedRoomNumber.size() >= 1
        && data.normalizedRoomNumber.size() <= 30
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ==================================================
    // 5. METER VALIDATION
    // ==================================================

    function validMeter(data) {
      return data.keys().hasAll([
          'meterCode',
          'serialNumber',
          'notes',
          'status',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'meterCode',
          'serialNumber',
          'notes',
          'status',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.meterCode is string
        && data.meterCode.matches('^M[0-9]{4}$')
        && data.meterCode != 'M0000'
        && data.serialNumber is string
        && data.serialNumber.size() <= 80
        && data.notes is string
        && data.notes.size() <= 1000
        && data.status in ['available', 'assigned', 'retired', 'voided']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid;
    }

    // ==================================================
    // 6. METER ASSIGNMENT VALIDATION
    // ==================================================

    function validMeterAssignment(data) {
      return data.keys().hasAll([
          'meterId',
          'meterCode',
          'roomId',
          'roomCode',
          'propertyId',
          'propertyCode',
          'status',
          'assignedOn',
          'initialReading',
          'endedOn',
          'finalReading',
          'endReason',
          'endNotes',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'meterId',
          'meterCode',
          'roomId',
          'roomCode',
          'propertyId',
          'propertyCode',
          'status',
          'assignedOn',
          'initialReading',
          'endedOn',
          'finalReading',
          'endReason',
          'endNotes',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.meterId is string
        && data.meterId.size() > 0
        && data.meterCode is string
        && data.meterCode.matches('^M[0-9]{4}$')
        && data.meterCode != 'M0000'
        && data.roomId is string
        && data.roomId.size() > 0
        && data.roomCode is string
        && data.roomCode.matches('^R[0-9]{4}$')
        && data.roomCode != 'R0000'
        && data.propertyId is string
        && data.propertyId.size() > 0
        && data.propertyCode is string
        && data.propertyCode.matches('^P[0-9]{2}$')
        && data.propertyCode != 'P00'
        && data.status in ['current', 'ended']
        && data.assignedOn is string
        && data.assignedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (
          (data.initialReading is int && data.initialReading >= 0)
          || (data.initialReading is float && data.initialReading >= 0)
        )
        && (
          data.endedOn == null
          || (
            data.endedOn is string
            && data.endedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          )
        )
        && (
          data.finalReading == null
          || (
            data.finalReading is int
            && data.finalReading >= 0
          )
          || (
            data.finalReading is float
            && data.finalReading >= 0
          )
        )
        && (
          data.endReason == null
          || data.endReason in [
            'damaged',
            'overreading',
            'slow_reading',
            'other'
          ]
        )
        && data.endNotes is string
        && data.endNotes.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid
        && (
          (
            data.status == 'current'
            && data.endedOn == null
            && data.finalReading == null
            && data.endReason == null
          )
          || (
            data.status == 'ended'
            && data.endedOn is string
            && data.endedOn >= data.assignedOn
            && data.finalReading != null
            && data.endReason in [
              'damaged',
              'overreading',
              'slow_reading',
              'other'
            ]
          )
        );
    }

    function validMeterAssignmentRoom(userId, data) {
      return data.propertyCode.matches('^P[0-9]{2}$')
        && exists(
          /databases/$(database)/documents/users/$(userId)/rooms/$(data.roomId)
        )
        && get(
          /databases/$(database)/documents/users/$(userId)/rooms/$(data.roomId)
        ).data.roomCode == data.roomCode
        && get(
          /databases/$(database)/documents/users/$(userId)/rooms/$(data.roomId)
        ).data.propertyId == data.propertyId
        && get(
          /databases/$(database)/documents/users/$(userId)/rooms/$(data.roomId)
        ).data.propertyCode == data.propertyCode
        && get(
          /databases/$(database)/documents/users/$(userId)/rooms/$(data.roomId)
        ).data.status != 'inactive'
        && roomPropertyIsActive(userId, data);
    }

    // ==================================================
    // 7. CURRENT METER INDEX VALIDATION
    // ==================================================

    function validCurrentMeterIndex(data) {
      return data.keys().hasAll([
          'meterId',
          'meterCode',
          'roomId',
          'assignmentId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'meterId',
          'meterCode',
          'roomId',
          'assignmentId',
          'createdAt',
          'updatedAt'
        ])
        && data.meterId is string
        && data.meterId.size() > 0
        && data.meterCode is string
        && data.meterCode.matches('^M[0-9]{4}$')
        && data.meterCode != 'M0000'
        && data.roomId is string
        && data.roomId.size() > 0
        && data.assignmentId is string
        && data.assignmentId.size() > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Check that the meter, assignment and both current indexes
    // agree after the transaction has completed.
    function validCurrentMeterPair(
      userId,
      assignmentId,
      meterId,
      meterCode,
      roomId
    ) {
      return existsAfter(
          /databases/$(database)/documents/users/$(userId)/meters/$(meterId)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/meters/$(meterId)
        ).data.meterCode == meterCode
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/meters/$(meterId)
        ).data.status == 'assigned'

        && existsAfter(
          /databases/$(database)/documents/users/$(userId)/meterAssignments/$(assignmentId)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/meterAssignments/$(assignmentId)
        ).data.status == 'current'
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/meterAssignments/$(assignmentId)
        ).data.meterId == meterId
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/meterAssignments/$(assignmentId)
        ).data.meterCode == meterCode
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/meterAssignments/$(assignmentId)
        ).data.roomId == roomId

        && existsAfter(
          /databases/$(database)/documents/users/$(userId)/currentMeterByRoom/$(roomId)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/currentMeterByRoom/$(roomId)
        ).data.meterId == meterId
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/currentMeterByRoom/$(roomId)
        ).data.assignmentId == assignmentId

        && existsAfter(
          /databases/$(database)/documents/users/$(userId)/currentAssignmentByMeter/$(meterId)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/currentAssignmentByMeter/$(meterId)
        ).data.meterId == meterId
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/currentAssignmentByMeter/$(meterId)
        ).data.roomId == roomId
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/currentAssignmentByMeter/$(meterId)
        ).data.assignmentId == assignmentId;
    }

    function validMeterAssignedAfter(userId, meterId, meterCode) {
      let indexPath =
        /databases/$(database)/documents/users/$(userId)/currentAssignmentByMeter/$(meterId);

      return existsAfter(indexPath)
        && getAfter(indexPath).data.meterId == meterId
        && getAfter(indexPath).data.meterCode == meterCode
        && validCurrentMeterPair(
          userId,
          getAfter(indexPath).data.assignmentId,
          meterId,
          meterCode,
          getAfter(indexPath).data.roomId
        );
    }

    function validMeterRetirementAfter(userId, meterId) {
      let indexPath =
        /databases/$(database)/documents/users/$(userId)/currentAssignmentByMeter/$(meterId);

      return exists(indexPath)
        && get(indexPath).data.meterId == meterId
        && !existsAfter(indexPath)
        && existsAfter(
          /databases/$(database)/documents/users/$(userId)/meterAssignments/$(get(indexPath).data.assignmentId)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/meterAssignments/$(get(indexPath).data.assignmentId)
        ).data.status == 'ended'
        && (
          !existsAfter(
            /databases/$(database)/documents/users/$(userId)/currentMeterByRoom/$(get(indexPath).data.roomId)
          )
          || getAfter(
            /databases/$(database)/documents/users/$(userId)/currentMeterByRoom/$(get(indexPath).data.roomId)
          ).data.meterId != meterId
        );
    }

    // A mistaken meter may be voided only when its current assignment is
    // ended and both active indexes are removed in the same atomic operation.
    function validMeterCancellationAfter(userId, meterId) {
      let meterIndexPath =
        /databases/$(database)/documents/users/$(userId)/currentAssignmentByMeter/$(meterId);
      let oldRoomId = get(meterIndexPath).data.roomId;
      let assignmentId = get(meterIndexPath).data.assignmentId;
      let assignmentPath =
        /databases/$(database)/documents/users/$(userId)/meterAssignments/$(assignmentId);
      let roomIndexPath =
        /databases/$(database)/documents/users/$(userId)/currentMeterByRoom/$(oldRoomId);
      let readingStatePath =
        /databases/$(database)/documents/users/$(userId)/electricityReadingState/$(assignmentId);

      return exists(meterIndexPath)
        && get(meterIndexPath).data.meterId == meterId
        && exists(roomIndexPath)
        && get(roomIndexPath).data.meterId == meterId
        && get(roomIndexPath).data.assignmentId == assignmentId
        && !existsAfter(meterIndexPath)
        && existsAfter(assignmentPath)
        && getAfter(assignmentPath).data.status == 'ended'
        && getAfter(assignmentPath).data.meterId == meterId
        && getAfter(assignmentPath).data.roomId == oldRoomId
        && !exists(readingStatePath)
        && !existsAfter(roomIndexPath);
    }

    function validMeterUnassignmentAfter(userId, data) {
      let indexPath =
        /databases/$(database)/documents/users/$(userId)/currentAssignmentByMeter/$(data.meterId);

      return exists(indexPath)
        && get(indexPath).data.assignmentId is string
        && !existsAfter(indexPath)
        && existsAfter(
          /databases/$(database)/documents/users/$(userId)/meterAssignments/$(get(indexPath).data.assignmentId)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/meterAssignments/$(get(indexPath).data.assignmentId)
        ).data.status == 'ended'
        && (
          !existsAfter(
            /databases/$(database)/documents/users/$(userId)/currentMeterByRoom/$(data.roomId)
          )
          || getAfter(
            /databases/$(database)/documents/users/$(userId)/currentMeterByRoom/$(data.roomId)
          ).data.meterId != data.meterId
        );
    }

    // A room correction keeps the same physical meter assigned, but moves its
    // current pointer to a new room/assignment. The old assignment is retained
    // as an ended history record and the previous room index is removed.
    function validMeterRoomCorrectionAfter(userId, assignmentId, meterId, oldRoomId) {
      let meterIndexPath =
        /databases/$(database)/documents/users/$(userId)/currentAssignmentByMeter/$(meterId);
      let oldAssignmentPath =
        /databases/$(database)/documents/users/$(userId)/meterAssignments/$(assignmentId);
      let oldRoomIndexPath =
        /databases/$(database)/documents/users/$(userId)/currentMeterByRoom/$(oldRoomId);
      let newAssignmentId = getAfter(meterIndexPath).data.assignmentId;
      let newRoomId = getAfter(meterIndexPath).data.roomId;
      let newAssignmentPath =
        /databases/$(database)/documents/users/$(userId)/meterAssignments/$(newAssignmentId);
      let newRoomIndexPath =
        /databases/$(database)/documents/users/$(userId)/currentMeterByRoom/$(newRoomId);

      return exists(meterIndexPath)
        && get(meterIndexPath).data.assignmentId == assignmentId
        && existsAfter(meterIndexPath)
        && newAssignmentId is string
        && newAssignmentId != assignmentId
        && newRoomId is string
        && newRoomId != oldRoomId
        && existsAfter(oldAssignmentPath)
        && getAfter(oldAssignmentPath).data.status == 'ended'
        && getAfter(oldAssignmentPath).data.meterId == meterId
        && getAfter(oldAssignmentPath).data.roomId == oldRoomId
        && existsAfter(newAssignmentPath)
        && getAfter(newAssignmentPath).data.status == 'current'
        && getAfter(newAssignmentPath).data.meterId == meterId
        && getAfter(newAssignmentPath).data.roomId == newRoomId
        && getAfter(newAssignmentPath).data.assignedOn == get(oldAssignmentPath).data.assignedOn
        && getAfter(newAssignmentPath).data.initialReading == get(oldAssignmentPath).data.initialReading
        && !existsAfter(oldRoomIndexPath)
        && existsAfter(newRoomIndexPath)
        && getAfter(newRoomIndexPath).data.meterId == meterId
        && getAfter(newRoomIndexPath).data.assignmentId == newAssignmentId
        && getAfter(newRoomIndexPath).data.roomId == newRoomId;
    }

    // ==================================================
    // TENANT / ROOM ASSIGNMENT VALIDATION
    // ==================================================

    function validTenantAssignment(data) {
      return data.keys().hasAll([
          'tenantId',
          'tenantCode',
          'tenantName',
          'roomId',
          'roomCode',
          'roomNumber',
          'floorName',
          'propertyId',
          'propertyCode',
          'moveInDate',
          'moveOutDate',
          'status',
          'notes',
          'moveOutNotes',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'tenantId',
          'tenantCode',
          'tenantName',
          'roomId',
          'roomCode',
          'roomNumber',
          'floorName',
          'propertyId',
          'propertyCode',
          'moveInDate',
          'moveOutDate',
          'status',
          'notes',
          'moveOutNotes',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.tenantId is string
        && data.tenantId.size() > 0
        && data.tenantCode is string
        && data.tenantCode.matches('^T[0-9]{5}[A-Z]$')
        && data.tenantName is string
        && data.tenantName.size() >= 2
        && data.tenantName.size() <= 100
        && data.roomId is string
        && data.roomId.size() > 0
        && data.roomCode is string
        && data.roomCode.matches('^R[0-9]{4}$')
        && data.roomCode != 'R0000'
        && data.roomNumber is string
        && data.roomNumber.size() >= 1
        && data.roomNumber.size() <= 30
        && data.floorName is string
        && data.floorName.size() >= 1
        && data.floorName.size() <= 80
        && data.propertyId is string
        && data.propertyId.size() > 0
        && data.propertyCode is string
        && data.propertyCode.matches('^P[0-9]{2}$')
        && data.propertyCode != 'P00'
        && data.moveInDate is string
        && data.moveInDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (
          data.moveOutDate == null
          || (
            data.moveOutDate is string
            && data.moveOutDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && data.moveOutDate >= data.moveInDate
          )
        )
        && data.status in ['current', 'ended']
        && data.notes is string
        && data.notes.size() <= 1000
        && data.moveOutNotes is string
        && data.moveOutNotes.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid
        && (
          (
            data.status == 'current'
            && data.moveOutDate == null
            && data.moveOutNotes == ''
          )
          || (
            data.status == 'ended'
            && data.moveOutDate is string
            && data.moveOutDate >= data.moveInDate
          )
        );
    }

    function validTenantAssignmentTenant(userId, data) {
      let tenantPath =
        /databases/$(database)/documents/users/$(userId)/tenants/$(data.tenantId);

      return exists(tenantPath)
        && get(tenantPath).data.tenantCode == data.tenantCode
        && get(tenantPath).data.fullName == data.tenantName
        && get(tenantPath).data.status == 'active';
    }

    function validTenantAssignmentRoom(userId, data) {
      let roomPath =
        /databases/$(database)/documents/users/$(userId)/rooms/$(data.roomId);

      return exists(roomPath)
        && get(roomPath).data.roomCode == data.roomCode
        && get(roomPath).data.roomNumber == data.roomNumber
        && get(roomPath).data.floorName == data.floorName
        && get(roomPath).data.propertyId == data.propertyId
        && get(roomPath).data.propertyCode == data.propertyCode
        && get(roomPath).data.status == 'vacant'
        && roomPropertyIsActive(userId, data);
    }

    function validCurrentTenantIndex(data) {
      return data.keys().hasAll([
          'tenantId',
          'tenantCode',
          'tenantName',
          'roomId',
          'roomCode',
          'roomNumber',
          'floorName',
          'propertyId',
          'propertyCode',
          'assignmentId',
          'moveInDate',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'tenantId',
          'tenantCode',
          'tenantName',
          'roomId',
          'roomCode',
          'roomNumber',
          'floorName',
          'propertyId',
          'propertyCode',
          'assignmentId',
          'moveInDate',
          'createdAt',
          'updatedAt'
        ])
        && data.tenantId is string
        && data.tenantId.size() > 0
        && data.tenantCode is string
        && data.tenantCode.matches('^T[0-9]{5}[A-Z]$')
        && data.tenantName is string
        && data.tenantName.size() >= 2
        && data.tenantName.size() <= 100
        && data.roomId is string
        && data.roomId.size() > 0
        && data.roomCode is string
        && data.roomCode.matches('^R[0-9]{4}$')
        && data.roomCode != 'R0000'
        && data.roomNumber is string
        && data.roomNumber.size() >= 1
        && data.roomNumber.size() <= 30
        && data.floorName is string
        && data.floorName.size() >= 1
        && data.floorName.size() <= 80
        && data.propertyId is string
        && data.propertyId.size() > 0
        && data.propertyCode is string
        && data.propertyCode.matches('^P[0-9]{2}$')
        && data.propertyCode != 'P00'
        && data.assignmentId is string
        && data.assignmentId.size() > 0
        && data.moveInDate is string
        && data.moveInDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // An active tenant assignment must agree with its room and its unique
    // currentTenantByRoom index. A tenant may have multiple room assignments,
    // so currentRoomByTenant is retained only as a legacy reverse pointer.
    function validCurrentTenantAssignmentPair(userId, assignmentId, data) {
      let assignmentPath =
        /databases/$(database)/documents/users/$(userId)/tenantAssignments/$(assignmentId);
      let roomIndexPath =
        /databases/$(database)/documents/users/$(userId)/currentTenantByRoom/$(data.roomId);

      return existsAfter(assignmentPath)
        && getAfter(assignmentPath).data.status == 'current'
        && getAfter(assignmentPath).data.tenantId == data.tenantId
        && getAfter(assignmentPath).data.tenantCode == data.tenantCode
        && getAfter(assignmentPath).data.tenantName == data.tenantName
        && getAfter(assignmentPath).data.roomId == data.roomId
        && getAfter(assignmentPath).data.roomCode == data.roomCode
        && getAfter(assignmentPath).data.roomNumber == data.roomNumber
        && getAfter(assignmentPath).data.floorName == data.floorName
        && getAfter(assignmentPath).data.propertyId == data.propertyId
        && getAfter(assignmentPath).data.propertyCode == data.propertyCode
        && getAfter(assignmentPath).data.moveInDate == data.moveInDate
        && existsAfter(roomIndexPath)
        && getAfter(roomIndexPath).data.assignmentId == assignmentId
        && getAfter(roomIndexPath).data.tenantId == data.tenantId
        && getAfter(roomIndexPath).data.roomId == data.roomId
        && getAfter(roomIndexPath).data.tenantCode == data.tenantCode
        && getAfter(roomIndexPath).data.tenantName == data.tenantName
        && getAfter(roomIndexPath).data.roomCode == data.roomCode
        && getAfter(roomIndexPath).data.roomNumber == data.roomNumber
        && getAfter(roomIndexPath).data.floorName == data.floorName
        && getAfter(roomIndexPath).data.propertyId == data.propertyId
        && getAfter(roomIndexPath).data.propertyCode == data.propertyCode
        && getAfter(roomIndexPath).data.moveInDate == data.moveInDate;
    }

    // Older project versions created one currentRoomByTenant reverse pointer.
    // During a move-out it may either be removed (when it points to the ended
    // assignment) or retained (when it still points to another current room).
    function validLegacyTenantPointerAfter(userId, tenantId, endedAssignmentId) {
      let tenantIndexPath =
        /databases/$(database)/documents/users/$(userId)/currentRoomByTenant/$(tenantId);
      let tenantIndex = getAfter(tenantIndexPath).data;
      let linkedAssignmentPath =
        /databases/$(database)/documents/users/$(userId)/tenantAssignments/$(tenantIndex.assignmentId);

      return tenantIndex.tenantId == tenantId
        && tenantIndex.assignmentId is string
        && tenantIndex.assignmentId != endedAssignmentId
        && existsAfter(linkedAssignmentPath)
        && getAfter(linkedAssignmentPath).data.status == 'current'
        && getAfter(linkedAssignmentPath).data.tenantId == tenantId;
    }

    function legacyTenantPointerRemovedOrValidAfter(userId, tenantId, endedAssignmentId) {
      let tenantIndexPath =
        /databases/$(database)/documents/users/$(userId)/currentRoomByTenant/$(tenantId);
      return !existsAfter(tenantIndexPath)
        || validLegacyTenantPointerAfter(userId, tenantId, endedAssignmentId);
    }

    function validTenantAssignmentEndedAfter(userId, assignmentId, data) {
      let assignmentPath =
        /databases/$(database)/documents/users/$(userId)/tenantAssignments/$(assignmentId);
      let roomIndexPath =
        /databases/$(database)/documents/users/$(userId)/currentTenantByRoom/$(data.roomId);

      return existsAfter(assignmentPath)
        && getAfter(assignmentPath).data.status == 'ended'
        && getAfter(assignmentPath).data.tenantId == data.tenantId
        && getAfter(assignmentPath).data.roomId == data.roomId
        && !existsAfter(roomIndexPath)
        && legacyTenantPointerRemovedOrValidAfter(userId, data.tenantId, assignmentId);
    }

    // Deleting the room index is valid once its assignment has ended. A
    // legacy tenant-wide pointer may remain for a different active room.
    function validTenantRoomIndexRemoval(userId, data) {
      let assignmentPath =
        /databases/$(database)/documents/users/$(userId)/tenantAssignments/$(data.assignmentId);
      let roomIndexPath =
        /databases/$(database)/documents/users/$(userId)/currentTenantByRoom/$(data.roomId);

      return existsAfter(assignmentPath)
        && getAfter(assignmentPath).data.status == 'ended'
        && getAfter(assignmentPath).data.tenantId == data.tenantId
        && getAfter(assignmentPath).data.tenantCode == data.tenantCode
        && getAfter(assignmentPath).data.roomId == data.roomId
        && getAfter(assignmentPath).data.roomCode == data.roomCode
        && !existsAfter(roomIndexPath)
        && legacyTenantPointerRemovedOrValidAfter(userId, data.tenantId, data.assignmentId);
    }

    // The legacy reverse pointer itself can only be removed if it points to
    // the assignment being ended, and that room's current index is removed too.
    function validLegacyTenantIndexRemoval(userId, data) {
      let assignmentPath =
        /databases/$(database)/documents/users/$(userId)/tenantAssignments/$(data.assignmentId);
      let roomIndexPath =
        /databases/$(database)/documents/users/$(userId)/currentTenantByRoom/$(data.roomId);
      let tenantIndexPath =
        /databases/$(database)/documents/users/$(userId)/currentRoomByTenant/$(data.tenantId);

      return existsAfter(assignmentPath)
        && getAfter(assignmentPath).data.status == 'ended'
        && getAfter(assignmentPath).data.tenantId == data.tenantId
        && getAfter(assignmentPath).data.tenantCode == data.tenantCode
        && getAfter(assignmentPath).data.roomId == data.roomId
        && getAfter(assignmentPath).data.roomCode == data.roomCode
        && !existsAfter(roomIndexPath)
        && !existsAfter(tenantIndexPath);
    }

    // ==================================================
    // SHARED WORKSPACE MEMBERSHIP AND INVITATIONS
    // ==================================================

    match /users/{userId}/workspaceMembers/{memberUid} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || memberUid == request.auth.uid || isWorkspaceMember(userId));
      allow list: if isWorkspaceMember(userId);

      // The existing UID namespace is the permanent workspace owner.
      allow create: if (
          validWorkspaceMember(memberUid, request.resource.data)
          && memberUid == userId
          && request.auth != null
          && request.auth.uid == userId
          && request.resource.data.email == request.auth.token.email.lower()
          && request.resource.data.status == 'active'
          && request.resource.data.invitationId == ''
          && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.invitedByEmail == request.auth.token.email.lower()
          && request.resource.data.isWorkspaceOwner == true
        ) || (
          validWorkspaceMember(memberUid, request.resource.data)
          && request.auth != null
          && request.auth.uid == memberUid
          && request.resource.data.status == 'active'
          && request.resource.data.isWorkspaceOwner == false
          && request.resource.data.email == request.auth.token.email.lower()
          && request.resource.data.invitationId is string
          && request.resource.data.invitationId.matches('^[a-f0-9]{64}$')
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId))
          && get(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.status == 'pending'
          && get(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.workspaceUid == userId
          && get(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.invitedEmail == request.resource.data.email
          && get(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.createdBy == request.resource.data.invitedBy
          && get(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.createdByEmail == request.resource.data.invitedByEmail
          && get(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.expiresAt > request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.acceptedBy == request.auth.uid
        );

      // Existing members may be revoked by another active member, never by
      // themselves and never if they are the original workspace owner.
      allow update: if (
          isWorkspaceMember(userId)
          && request.auth.uid != memberUid
          && resource.data.isWorkspaceOwner == false
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.role == resource.data.role
          && request.resource.data.invitationId == resource.data.invitationId
          && request.resource.data.invitedBy == resource.data.invitedBy
          && request.resource.data.invitedByEmail == resource.data.invitedByEmail
          && request.resource.data.isWorkspaceOwner == false
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.createdAt == resource.data.createdAt
          && resource.data.status == 'active'
          && request.resource.data.status == 'revoked'
          && request.resource.data.revokedBy == request.auth.uid
          && request.resource.data.revokedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedBy', 'revokedAt'])
        ) || (
          // A revoked account can rejoin only by accepting a fresh invitation
          // addressed to its verified email. Keep the same auth UID and record.
          request.auth != null
          && request.auth.uid == memberUid
          && request.auth.token.email_verified == true
          && request.auth.token.email is string
          && resource.data.isWorkspaceOwner == false
          && resource.data.status == 'revoked'
          && request.resource.data.status == 'active'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email is string
          && request.auth.token.email.lower() == request.resource.data.email
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.role == 'full_access'
          && request.resource.data.isWorkspaceOwner == false
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.invitationId is string
          && request.resource.data.invitationId.matches('^[a-f0-9]{64}$')
          && request.resource.data.joinedAt is timestamp
          && exists(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId))
          && get(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.status == 'pending'
          && get(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.invitedEmail == request.resource.data.email
          && get(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.createdBy == request.resource.data.invitedBy
          && get(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.createdByEmail == request.resource.data.invitedByEmail
          && get(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.expiresAt > request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/users/$(userId)/workspaceInvitations/$(request.resource.data.invitationId)).data.acceptedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'email', 'invitationId', 'invitedBy', 'invitedByEmail', 'joinedAt', 'revokedBy', 'revokedAt'
          ])
        );

      allow delete: if false;
    }

    match /users/{userId}/workspaceInvitations/{invitationId} {
      allow get: if isWorkspaceMember(userId)
        || (
          request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.status == 'pending'
          && request.auth.token.email is string
          && request.auth.token.email.lower() == resource.data.invitedEmail
          && resource.data.workspaceUid == userId
          && resource.data.expiresAt is timestamp
          && resource.data.expiresAt > request.time
        );
      allow list: if isWorkspaceMember(userId);

      allow create: if isWorkspaceMember(userId)
        && validInvitationCreate(userId, invitationId, request.resource.data);

      allow update: if (
          isWorkspaceMember(userId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'revoked'
          && request.resource.data.revokedBy == request.auth.uid
          && request.resource.data.revokedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedBy', 'revokedAt'])
        ) || validInvitationAcceptance(userId, invitationId, resource.data);

      allow delete: if false;
    }

    // ==================================================
    // 8. PROPERTY RECORDS
    // ==================================================

    match /users/{userId}/properties/{propertyId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validProperty(request.resource.data)
        && createdByCurrentActor(request.resource.data);

      allow update: if isOwner(userId)
        && validProperty(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.status == resource.data.status
        && (
          !('propertyCode' in resource.data)
          || request.resource.data.propertyCode == resource.data.propertyCode
        );

      allow delete: if false;
    }

    // ==================================================
    // 9. PROPERTY NAME INDEX
    // ==================================================

    match /users/{userId}/propertyNameIndex/{indexId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validNameIndex(request.resource.data);

      allow update: if isOwner(userId)
        && validNameIndex(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isOwner(userId);
    }

    // ==================================================
    // 10. SHARED PERMANENT ID SEQUENCES
    // ==================================================

    function isKnownSequence(systemId) {
      return systemId == 'propertySequence'
        || systemId == 'tenantSequence'
        || systemId == 'roomSequence'
        || systemId == 'meterSequence';
    }

    function validSequence(systemId, data) {
      return data.keys().hasAll([
          'nextNumber',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'nextNumber',
          'updatedAt'
        ])
        && data.nextNumber is int
        && data.updatedAt is timestamp
        && (
          (
            systemId == 'propertySequence'
            && data.nextNumber >= 2
            && data.nextNumber <= 100
          )
          || (
            systemId == 'tenantSequence'
            && data.nextNumber >= 1
            && data.nextNumber <= 2600000
          )
          || (
            (
              systemId == 'roomSequence'
              || systemId == 'meterSequence'
            )
            && data.nextNumber >= 2
            && data.nextNumber <= 10000
          )
        );
    }

    match /users/{userId}/system/{systemId} {
      allow read: if isOwner(userId)
        && isKnownSequence(systemId);

      allow create: if isOwner(userId)
        && isKnownSequence(systemId)
        && validSequence(systemId, request.resource.data);

      allow update: if isOwner(userId)
        && isKnownSequence(systemId)
        && validSequence(systemId, request.resource.data)
        && resource.data.nextNumber is int
        && request.resource.data.nextNumber > resource.data.nextNumber;

      allow delete: if false;
    }

    // ==================================================
    // 11. ROOM RECORDS
    // ==================================================

    match /users/{userId}/rooms/{roomId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validRoom(request.resource.data, userId)
        && createdByCurrentActor(request.resource.data);

      allow update: if isOwner(userId)
        && validRoom(request.resource.data, userId)
        && request.resource.data.roomCode == resource.data.roomCode
        && request.resource.data.propertyId == resource.data.propertyId
        && request.resource.data.propertyCode == resource.data.propertyCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if false;
    }

    // ==================================================
    // 12. ROOM NAME INDEX
    // ==================================================

    match /users/{userId}/roomNameIndex/{indexId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validRoomNameIndex(request.resource.data);

      allow update: if isOwner(userId)
        && validRoomNameIndex(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isOwner(userId);
    }

    // ==================================================
    // 13. TENANT RECORDS
    // ==================================================

    match /users/{userId}/tenants/{tenantId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validTenant(request.resource.data)
        && createdByCurrentActor(request.resource.data);

      allow update: if isOwner(userId)
        && validTenant(request.resource.data)
        && request.resource.data.tenantCode == resource.data.tenantCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if false;
    }

    // ==================================================
    // 14. METER RECORDS
    // ==================================================

    match /users/{userId}/meters/{meterId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validMeter(request.resource.data)
        && createdByCurrentActor(request.resource.data)
        && (
          request.resource.data.status == 'available'
          || (
            request.resource.data.status == 'assigned'
            && validMeterAssignedAfter(
              userId,
              meterId,
              request.resource.data.meterCode
            )
          )
        );

      allow update: if isOwner(userId)
        && validMeter(request.resource.data)
        && request.resource.data.meterCode == resource.data.meterCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          (
            request.resource.data.status == resource.data.status
            && (
              resource.data.status != 'assigned'
              || validMeterAssignedAfter(
                userId,
                meterId,
                request.resource.data.meterCode
              )
            )
          )
          || (
            resource.data.status == 'available'
            && request.resource.data.status == 'assigned'
            && validMeterAssignedAfter(
              userId,
              meterId,
              request.resource.data.meterCode
            )
          )
          || (
            resource.data.status == 'assigned'
            && request.resource.data.status == 'retired'
            && validMeterRetirementAfter(userId, meterId)
          )
          || (
            resource.data.status == 'assigned'
            && request.resource.data.status == 'voided'
            && validMeterCancellationAfter(userId, meterId)
          )
        );

      allow delete: if false;
    }

    // ==================================================
    // 15. METER ASSIGNMENT HISTORY
    // ==================================================

    match /users/{userId}/meterAssignments/{assignmentId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validMeterAssignment(request.resource.data)
        && createdByCurrentActor(request.resource.data)
        && request.resource.data.status == 'current'
        && validMeterAssignmentRoom(userId, request.resource.data)
        && validCurrentMeterPair(
          userId,
          assignmentId,
          request.resource.data.meterId,
          request.resource.data.meterCode,
          request.resource.data.roomId
        );

      allow update: if isOwner(userId)
        && validMeterAssignment(request.resource.data)
        && resource.data.status == 'current'
        && request.resource.data.status == 'ended'
        && request.resource.data.meterId == resource.data.meterId
        && request.resource.data.meterCode == resource.data.meterCode
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.roomCode == resource.data.roomCode
        && request.resource.data.propertyId == resource.data.propertyId
        && request.resource.data.propertyCode == resource.data.propertyCode
        && request.resource.data.assignedOn == resource.data.assignedOn
        && request.resource.data.initialReading == resource.data.initialReading
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          validMeterUnassignmentAfter(userId, request.resource.data)
          || validMeterRoomCorrectionAfter(
            userId,
            assignmentId,
            resource.data.meterId,
            resource.data.roomId
          )
        );

      allow delete: if false;
    }

    // ==================================================
    // 16. ONE CURRENT METER PER ROOM
    // ==================================================

    match /users/{userId}/currentMeterByRoom/{roomId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validCurrentMeterIndex(request.resource.data)
        && request.resource.data.roomId == roomId
        && validCurrentMeterPair(
          userId,
          request.resource.data.assignmentId,
          request.resource.data.meterId,
          request.resource.data.meterCode,
          request.resource.data.roomId
        );

      allow update: if isOwner(userId)
        && validCurrentMeterIndex(request.resource.data)
        && request.resource.data.roomId == roomId
        && resource.data.roomId == roomId
        && request.resource.data.createdAt == resource.data.createdAt
        && validCurrentMeterPair(
          userId,
          request.resource.data.assignmentId,
          request.resource.data.meterId,
          request.resource.data.meterCode,
          request.resource.data.roomId
        );

      // A room index may be removed only as part of a validated room
      // correction or an unassignment/cancellation.
      allow delete: if isOwner(userId)
        && resource.data.roomId == roomId
        && (
          validMeterUnassignmentAfter(userId, resource.data)
          || validMeterRoomCorrectionAfter(
            userId,
            resource.data.assignmentId,
            resource.data.meterId,
            roomId
          )
        );
    }

    // ==================================================
    // 17. ONE CURRENT ROOM PER METER
    // ==================================================

    match /users/{userId}/currentAssignmentByMeter/{meterId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validCurrentMeterIndex(request.resource.data)
        && request.resource.data.meterId == meterId
        && validCurrentMeterPair(
          userId,
          request.resource.data.assignmentId,
          request.resource.data.meterId,
          request.resource.data.meterCode,
          request.resource.data.roomId
        );

      allow update: if isOwner(userId)
        && validCurrentMeterIndex(request.resource.data)
        && request.resource.data.meterId == meterId
        && resource.data.meterId == meterId
        && request.resource.data.createdAt == resource.data.createdAt
        && validCurrentMeterPair(
          userId,
          request.resource.data.assignmentId,
          request.resource.data.meterId,
          request.resource.data.meterCode,
          request.resource.data.roomId
        );

      allow delete: if isOwner(userId)
        && validMeterUnassignmentAfter(userId, resource.data);
    }

    // ==================================================
    // 18. TENANT ASSIGNMENT HISTORY
    // ==================================================

    match /users/{userId}/tenantAssignments/{assignmentId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validTenantAssignment(request.resource.data)
        && createdByCurrentActor(request.resource.data)
        && request.resource.data.status == 'current'
        && validTenantAssignmentTenant(userId, request.resource.data)
        && validTenantAssignmentRoom(userId, request.resource.data)
        && validCurrentTenantAssignmentPair(
          userId,
          assignmentId,
          request.resource.data
        );

      // An assignment may only transition from current to ended.
      // Its tenant, room, property and move-in snapshots cannot be rewritten.
      allow update: if isOwner(userId)
        && validTenantAssignment(request.resource.data)
        && resource.data.status == 'current'
        && request.resource.data.status == 'ended'
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.tenantCode == resource.data.tenantCode
        && request.resource.data.tenantName == resource.data.tenantName
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.roomCode == resource.data.roomCode
        && request.resource.data.roomNumber == resource.data.roomNumber
        && request.resource.data.floorName == resource.data.floorName
        && request.resource.data.propertyId == resource.data.propertyId
        && request.resource.data.propertyCode == resource.data.propertyCode
        && request.resource.data.moveInDate == resource.data.moveInDate
        && request.resource.data.notes == resource.data.notes
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && validTenantAssignmentEndedAfter(
          userId,
          assignmentId,
          request.resource.data
        );

      // Preserve ended assignments permanently for history and auditability.
      allow delete: if false;
    }

    // ==================================================
    // 19. ONE CURRENT TENANT PER ROOM (MULTIPLE ROOMS PER TENANT ARE ALLOWED)
    // ==================================================

    match /users/{userId}/currentTenantByRoom/{roomId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validCurrentTenantIndex(request.resource.data)
        && request.resource.data.roomId == roomId
        && validCurrentTenantAssignmentPair(
          userId,
          request.resource.data.assignmentId,
          request.resource.data
        );

      // Existing current indexes cannot be overwritten to bypass move-out.
      allow update: if false;

      allow delete: if isOwner(userId)
        && validTenantRoomIndexRemoval(userId, resource.data);
    }

    // ==================================================
    // 20. LEGACY TENANT-TO-ROOM REVERSE INDEX
    // ==================================================

    match /users/{userId}/currentRoomByTenant/{tenantId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validCurrentTenantIndex(request.resource.data)
        && request.resource.data.tenantId == tenantId
        && validCurrentTenantAssignmentPair(
          userId,
          request.resource.data.assignmentId,
          request.resource.data
        );

      allow update: if false;

      allow delete: if isOwner(userId)
        && validLegacyTenantIndexRemoval(userId, resource.data);
    }

    // ==================================================
    // 21. RENT RATE VALIDATION
    // ==================================================

    function validRentIsoDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validRentBillingMonth(value) {
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function validRentRateRoom(userId, data) {
      let roomPath =
        /databases/$(database)/documents/users/$(userId)/rooms/$(data.roomId);

      return exists(roomPath)
        && get(roomPath).data.roomCode == data.roomCode
        && get(roomPath).data.propertyId == data.propertyId
        && get(roomPath).data.propertyCode == data.propertyCode
        && roomPropertyIsActive(userId, data);
    }

    function validRentRate(userId, rateId, data) {
      return data.keys().hasAll([
          'roomId',
          'roomCode',
          'propertyId',
          'propertyCode',
          'effectiveFrom',
          'monthlyRentMinor',
          'notes',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'roomId',
          'roomCode',
          'propertyId',
          'propertyCode',
          'effectiveFrom',
          'monthlyRentMinor',
          'notes',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.roomId is string
        && data.roomId.size() > 0
        && data.roomCode is string
        && data.roomCode.matches('^R[0-9]{4}$')
        && data.roomCode != 'R0000'
        && data.propertyId is string
        && data.propertyId.size() > 0
        && data.propertyCode is string
        && data.propertyCode.matches('^P[0-9]{2}$')
        && data.propertyCode != 'P00'
        && validRentIsoDate(data.effectiveFrom)
        && data.monthlyRentMinor is int
        && data.monthlyRentMinor >= 1
        && data.monthlyRentMinor <= 10000000000
        && data.notes is string
        && data.notes.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid
        && rateId == data.roomId + '__' + data.effectiveFrom
        && validRentRateRoom(userId, data);
    }

    // ==================================================
    // 22. RENT BILL VALIDATION
    // ==================================================

    function validRentBill(userId, billId, data) {
      let assignmentPath =
        /databases/$(database)/documents/users/$(userId)/tenantAssignments/$(data.assignmentId);

      return data.keys().hasAll([
          'assignmentId',
          'tenantId',
          'tenantCode',
          'tenantName',
          'roomId',
          'roomCode',
          'roomNumber',
          'floorName',
          'propertyId',
          'propertyCode',
          'billingMonth',
          'occupancyStartDate',
          'occupancyEndDate',
          'chargedDays',
          'daysInMonth',
          'rateBreakdown',
          'totalMinor',
          'currency',
          'status',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'assignmentId',
          'tenantId',
          'tenantCode',
          'tenantName',
          'roomId',
          'roomCode',
          'roomNumber',
          'floorName',
          'propertyId',
          'propertyCode',
          'billingMonth',
          'occupancyStartDate',
          'occupancyEndDate',
          'chargedDays',
          'daysInMonth',
          'rateBreakdown',
          'totalMinor',
          'currency',
          'status',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.assignmentId is string
        && data.assignmentId.size() > 0
        && data.tenantId is string
        && data.tenantId.size() > 0
        && data.tenantCode is string
        && data.tenantCode.matches('^T[0-9]{5}[A-Z]$')
        && data.tenantName is string
        && data.tenantName.size() >= 2
        && data.tenantName.size() <= 100
        && data.roomId is string
        && data.roomId.size() > 0
        && data.roomCode is string
        && data.roomCode.matches('^R[0-9]{4}$')
        && data.roomCode != 'R0000'
        && data.roomNumber is string
        && data.roomNumber.size() >= 1
        && data.roomNumber.size() <= 30
        && data.floorName is string
        && data.floorName.size() >= 1
        && data.floorName.size() <= 80
        && data.propertyId is string
        && data.propertyId.size() > 0
        && data.propertyCode is string
        && data.propertyCode.matches('^P[0-9]{2}$')
        && data.propertyCode != 'P00'
        && validRentBillingMonth(data.billingMonth)
        && validRentIsoDate(data.occupancyStartDate)
        && validRentIsoDate(data.occupancyEndDate)
        && data.occupancyStartDate <= data.occupancyEndDate
        && data.occupancyStartDate[0:7] == data.billingMonth
        && data.occupancyEndDate[0:7] == data.billingMonth
        && data.chargedDays is int
        && data.chargedDays >= 1
        && data.chargedDays <= 31
        && data.daysInMonth is int
        && data.daysInMonth >= 28
        && data.daysInMonth <= 31
        && data.chargedDays <= data.daysInMonth
        && data.rateBreakdown is list
        && data.rateBreakdown.size() >= 1
        && data.rateBreakdown.size() <= 31
        && data.totalMinor is int
        && data.totalMinor >= 0
        && data.totalMinor <= 9000000000000000
        && data.currency == 'BDT'
        && data.status == 'issued'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid
        && billId == data.assignmentId + '__' + data.billingMonth
        && exists(assignmentPath)
        && get(assignmentPath).data.tenantId == data.tenantId
        && get(assignmentPath).data.tenantCode == data.tenantCode
        && get(assignmentPath).data.tenantName == data.tenantName
        && get(assignmentPath).data.roomId == data.roomId
        && get(assignmentPath).data.roomCode == data.roomCode
        && get(assignmentPath).data.roomNumber == data.roomNumber
        && get(assignmentPath).data.floorName == data.floorName
        && get(assignmentPath).data.propertyId == data.propertyId
        && get(assignmentPath).data.propertyCode == data.propertyCode
        && get(assignmentPath).data.moveInDate is string
        && data.occupancyStartDate >= get(assignmentPath).data.moveInDate
        && (
          get(assignmentPath).data.moveOutDate == null
          || data.occupancyEndDate <= get(assignmentPath).data.moveOutDate
        );
    }

    function validRentBillRoomMonthLock(userId, lockId, data) {
      let billPath =
        /databases/$(database)/documents/users/$(userId)/rentBills/$(data.billId);

      return data.keys().hasAll([
          'roomId', 'roomCode', 'billingMonth', 'billId', 'assignmentId',
          'tenantId', 'tenantCode', 'tenantName', 'createdAt', 'createdBy'
        ])
        && data.keys().hasOnly([
          'roomId', 'roomCode', 'billingMonth', 'billId', 'assignmentId',
          'tenantId', 'tenantCode', 'tenantName', 'createdAt', 'createdBy'
        ])
        && data.roomId is string
        && data.roomId.size() > 0
        && data.roomCode is string
        && data.roomCode.matches('^R[0-9]{4}$')
        && data.billingMonth is string
        && validRentBillingMonth(data.billingMonth)
        && lockId == data.roomId + '__' + data.billingMonth
        && data.assignmentId is string
        && data.assignmentId.size() > 0
        && data.billId is string
        && data.billId == data.assignmentId + '__' + data.billingMonth
        && data.tenantId is string
        && data.tenantId.size() > 0
        && data.tenantCode is string
        && data.tenantCode.matches('^T[0-9]{5}[A-Z]$')
        && data.tenantName is string
        && data.tenantName.size() >= 2
        && data.tenantName.size() <= 100
        && data.createdAt is timestamp
        && data.createdBy == request.auth.uid
        && existsAfter(billPath)
        && getAfter(billPath).data.roomId == data.roomId
        && getAfter(billPath).data.roomCode == data.roomCode
        && getAfter(billPath).data.billingMonth == data.billingMonth
        && getAfter(billPath).data.assignmentId == data.assignmentId
        && getAfter(billPath).data.tenantId == data.tenantId
        && getAfter(billPath).data.tenantCode == data.tenantCode
        && getAfter(billPath).data.tenantName == data.tenantName
        && getAfter(billPath).data.status == 'issued';
    }

    function rentBillRoomMonthLockMatchesAfter(userId, billId, data) {
      let lockId = data.roomId + '__' + data.billingMonth;
      let lockPath =
        /databases/$(database)/documents/users/$(userId)/rentBillRoomMonthLocks/$(lockId);

      return existsAfter(lockPath)
        && getAfter(lockPath).data.billId == billId
        && getAfter(lockPath).data.assignmentId == data.assignmentId
        && getAfter(lockPath).data.roomId == data.roomId
        && getAfter(lockPath).data.billingMonth == data.billingMonth
        && getAfter(lockPath).data.tenantId == data.tenantId;
    }

    // One room may receive at most one issued rent bill in a billing month.
    // The lock and bill are created atomically to prevent concurrent duplicates.
    match /users/{userId}/rentBillRoomMonthLocks/{lockId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validRentBillRoomMonthLock(userId, lockId, request.resource.data)
        && createdByCurrentActor(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    function validRentRateUsageLock(userId, rateId, data) {
      let ratePath =
        /databases/$(database)/documents/users/$(userId)/roomRentRates/$(rateId);
      let billPath =
        /databases/$(database)/documents/users/$(userId)/rentBills/$(data.billId);

      return data.keys().hasAll([
          'rateId', 'billId', 'roomId', 'rateSnapshot', 'createdAt', 'createdBy'
        ])
        && data.keys().hasOnly([
          'rateId', 'billId', 'roomId', 'rateSnapshot', 'createdAt', 'createdBy'
        ])
        && data.rateId == rateId
        && data.rateId is string
        && data.billId is string
        && data.billId.size() > 0
        && data.roomId is string
        && data.roomId.size() > 0
        && data.rateSnapshot is map
        && data.rateSnapshot.rateId == rateId
        && data.createdAt is timestamp
        && data.createdBy == request.auth.uid
        && exists(ratePath)
        && get(ratePath).data.roomId == data.roomId
        && existsAfter(billPath)
        && getAfter(billPath).data.roomId == data.roomId
        && getAfter(billPath).data.rateBreakdown is list
        && getAfter(billPath).data.rateBreakdown.hasAny([data.rateSnapshot]);
    }

    // One append-only usage lock protects each rent rate once an issued bill
    // references it. This makes deletion safe even after older bills are loaded
    // and their missing usage locks are backfilled by the Rent & Bills page.
    match /users/{userId}/roomRentRateUsageLocks/{rateId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validRentRateUsageLock(userId, rateId, request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    // ==================================================
    // 23. ROOM RENT RATE HISTORY
    // ==================================================

    match /users/{userId}/roomRentRates/{rateId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validRentRate(userId, rateId, request.resource.data)
        && createdByCurrentActor(request.resource.data)
        && !exists(
          /databases/$(database)/documents/users/$(userId)/roomRentRateUsageLocks/$(rateId)
        );

      // Rate values are immutable. An unused mistaken rate may be deleted;
      // an append-only usage lock protects any rate referenced by an issued bill.
      allow update: if false;
      allow delete: if isOwner(userId)
        && !exists(
          /databases/$(database)/documents/users/$(userId)/roomRentRateUsageLocks/$(rateId)
        );
    }

    // ==================================================
    // 24. GENERATED RENT BILLS
    // ==================================================

    match /users/{userId}/rentBills/{billId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validRentBill(userId, billId, request.resource.data)
        && rentBillRoomMonthLockMatchesAfter(userId, billId, request.resource.data)
        && createdByCurrentActor(request.resource.data);

      // Issued bills are historical financial records and cannot be rewritten.
      allow update: if false;
      allow delete: if false;
    }

    // ==================================================
    // 25. ELECTRICITY RATE HISTORY
    // ==================================================

    function validElectricityDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validElectricityMonth(value) {
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function validElectricityNumber(value) {
      return ((value is int) || (value is float))
        && value >= 0
        && value <= 1000000000;
    }

    function validSharedElectricityRate(rateId, data) {
      // Workspace defaults intentionally have no roomId/roomCode fields.
      return !('roomId' in data)
        && !('roomCode' in data)
        && rateId == 'rate__' + data.effectiveFrom;
    }

    function validRoomElectricityRate(userId, rateId, data) {
      let roomPath =
        /databases/$(database)/documents/users/$(userId)/rooms/$(data.roomId);

      return ('roomId' in data)
        && ('roomCode' in data)
        && data.roomId is string
        && data.roomId.size() > 0
        && data.roomCode is string
        && data.roomCode.matches('^R[0-9]{4}$')
        && data.roomCode != 'R0000'
        && exists(roomPath)
        && get(roomPath).data.roomCode == data.roomCode
        && rateId == 'rate__' + data.roomId + '__' + data.effectiveFrom;
    }

    function validElectricityRate(userId, rateId, data) {
      return data.keys().hasAll([
          'effectiveFrom',
          'pricePerUnitMinor',
          'notes',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'roomId',
          'roomCode',
          'effectiveFrom',
          'pricePerUnitMinor',
          'notes',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && validElectricityDate(data.effectiveFrom)
        && data.pricePerUnitMinor is int
        && data.pricePerUnitMinor >= 1
        && data.pricePerUnitMinor <= 10000000
        && data.notes is string
        && data.notes.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid
        && (
          validSharedElectricityRate(rateId, data)
          || validRoomElectricityRate(userId, rateId, data)
        );
    }
    // ==================================================
    // 26. ELECTRICITY METER READING HISTORY
    // ==================================================

    // Optional tenant-at-issue snapshot. Either all six fields are absent
    // (legacy/unoccupied room) or all six are present and validated.
    function validElectricityTenantSnapshot(data) {
      let hasAssignmentId = 'tenantAssignmentId' in data;
      let hasTenantId = 'tenantId' in data;
      let hasTenantCode = 'tenantCode' in data;
      let hasTenantName = 'tenantName' in data;
      let hasRoomNumber = 'tenantRoomNumber' in data;
      let hasFloorName = 'tenantFloorName' in data;

      return (
        (!hasAssignmentId && !hasTenantId && !hasTenantCode && !hasTenantName
          && !hasRoomNumber && !hasFloorName)
        || (
          hasAssignmentId && hasTenantId && hasTenantCode && hasTenantName
          && hasRoomNumber && hasFloorName
          && data.tenantAssignmentId is string
          && data.tenantAssignmentId.size() > 0
          && data.tenantAssignmentId.size() <= 200
          && data.tenantId is string
          && data.tenantId.size() > 0
          && data.tenantId.size() <= 200
          && data.tenantCode is string
          && data.tenantCode.matches('^T[0-9]{5}[A-Z]$')
          && data.tenantName is string
          && data.tenantName.size() >= 2
          && data.tenantName.size() <= 100
          && data.tenantRoomNumber is string
          && data.tenantRoomNumber.size() >= 1
          && data.tenantRoomNumber.size() <= 30
          && data.tenantFloorName is string
          && data.tenantFloorName.size() >= 1
          && data.tenantFloorName.size() <= 80
        )
      );
    }

    function validElectricityReading(userId, readingId, data) {
      let assignmentPath =
        /databases/$(database)/documents/users/$(userId)/meterAssignments/$(data.meterAssignmentId);
      let ratePath =
        /databases/$(database)/documents/users/$(userId)/electricityRates/$(data.rateId);
      let statePath =
        /databases/$(database)/documents/users/$(userId)/electricityReadingState/$(data.meterAssignmentId);
      let billPath =
        /databases/$(database)/documents/users/$(userId)/electricityBills/$(readingId);

      return data.keys().hasAll([
          'meterAssignmentId',
          'meterId',
          'meterCode',
          'roomId',
          'roomCode',
          'propertyId',
          'propertyCode',
          'billingMonth',
          'readingDate',
          'previousReading',
          'currentReading',
          'unitsConsumed',
          'rateId',
          'rateEffectiveFrom',
          'pricePerUnitMinor',
          'amountMinor',
          'notes',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'meterAssignmentId',
          'meterId',
          'meterCode',
          'roomId',
          'roomCode',
          'propertyId',
          'propertyCode',
          'billingMonth',
          'readingDate',
          'previousReading',
          'currentReading',
          'unitsConsumed',
          'rateId',
          'rateEffectiveFrom',
          'pricePerUnitMinor',
          'amountMinor',
          'notes',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy',
          'tenantAssignmentId',
          'tenantId',
          'tenantCode',
          'tenantName',
          'tenantRoomNumber',
          'tenantFloorName'
        ])
        && validElectricityTenantSnapshot(data)
        && data.meterAssignmentId is string
        && data.meterAssignmentId.size() > 0
        && data.meterId is string
        && data.meterId.size() > 0
        && data.meterCode.matches('^M[0-9]{4}$')
        && data.meterCode != 'M0000'
        && data.roomId is string
        && data.roomId.size() > 0
        && data.roomCode.matches('^R[0-9]{4}$')
        && data.roomCode != 'R0000'
        && data.propertyId is string
        && data.propertyId.size() > 0
        && data.propertyCode.matches('^P[0-9]{2}$')
        && data.propertyCode != 'P00'
        && validElectricityMonth(data.billingMonth)
        && validElectricityDate(data.readingDate)
        && data.readingDate[0:7] == data.billingMonth
        && validElectricityNumber(data.previousReading)
        && validElectricityNumber(data.currentReading)
        && data.currentReading > data.previousReading
        && validElectricityNumber(data.unitsConsumed)
        && data.unitsConsumed <= data.currentReading - data.previousReading + 0.000001
        && data.unitsConsumed >= data.currentReading - data.previousReading - 0.000001
        && data.rateId is string
        && data.rateEffectiveFrom is string
        && validElectricityDate(data.rateEffectiveFrom)
        && (
          data.rateId == 'rate__' + data.rateEffectiveFrom
          || data.rateId == 'rate__' + data.roomId + '__' + data.rateEffectiveFrom
        )
        && data.rateEffectiveFrom <= data.readingDate
        && data.pricePerUnitMinor is int
        && data.pricePerUnitMinor >= 1
        && data.pricePerUnitMinor <= 10000000
        && data.amountMinor is int
        && data.amountMinor >= 0
        && data.amountMinor <= 9000000000000000
        && data.notes is string
        && data.notes.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid
        && (
          readingId == data.meterAssignmentId + '__' + data.billingMonth
          || readingId == data.meterAssignmentId + '__' + data.readingDate
        )
        && exists(assignmentPath)
        && get(assignmentPath).data.meterId == data.meterId
        && get(assignmentPath).data.meterCode == data.meterCode
        && get(assignmentPath).data.roomId == data.roomId
        && get(assignmentPath).data.roomCode == data.roomCode
        && get(assignmentPath).data.propertyId == data.propertyId
        && get(assignmentPath).data.propertyCode == data.propertyCode
        && data.readingDate >= get(assignmentPath).data.assignedOn
        && (
          get(assignmentPath).data.status == 'current'
          || (
            get(assignmentPath).data.status == 'ended'
            && get(assignmentPath).data.endedOn is string
            && data.readingDate <= get(assignmentPath).data.endedOn
          )
        )
        && exists(ratePath)
        && get(ratePath).data.effectiveFrom == data.rateEffectiveFrom
        && get(ratePath).data.pricePerUnitMinor == data.pricePerUnitMinor
        && (
          (
            ('roomId' in get(ratePath).data)
            && get(ratePath).data.roomId == data.roomId
            && get(ratePath).data.roomCode == data.roomCode
            && data.rateId == 'rate__' + data.roomId + '__' + data.rateEffectiveFrom
          )
          || (
            !('roomId' in get(ratePath).data)
            && data.rateId == 'rate__' + data.rateEffectiveFrom
          )
        )
        && (
          (
            exists(statePath)
            && get(statePath).data.meterAssignmentId == data.meterAssignmentId
            && get(statePath).data.lastReadingValue == data.previousReading
            && data.readingDate > get(statePath).data.lastReadingDate
          )
          || (
            !exists(statePath)
            && data.previousReading == get(assignmentPath).data.initialReading
          )
        )
        && existsAfter(billPath)
        && getAfter(billPath).data.readingId == readingId
        && getAfter(billPath).data.meterAssignmentId == data.meterAssignmentId
        && getAfter(billPath).data.currentReading == data.currentReading
        && getAfter(billPath).data.amountMinor == data.amountMinor
        && existsAfter(statePath)
        && getAfter(statePath).data.lastReadingId == readingId
        && getAfter(statePath).data.lastReadingValue == data.currentReading
        && getAfter(statePath).data.lastReadingDate == data.readingDate;
    }

    match /users/{userId}/electricityRates/{rateId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validElectricityRate(userId, rateId, request.resource.data)
        && createdByCurrentActor(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId}/electricityReadings/{readingId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validElectricityReading(userId, readingId, request.resource.data)
        && createdByCurrentActor(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    // ==================================================
    // 27. ISSUED ELECTRICITY BILLS
    // ==================================================

    function validElectricityBill(userId, billId, data) {
      let readingPath =
        /databases/$(database)/documents/users/$(userId)/electricityReadings/$(data.readingId);

      return data.keys().hasAll([
          'readingId',
          'meterAssignmentId',
          'meterId',
          'meterCode',
          'roomId',
          'roomCode',
          'propertyId',
          'propertyCode',
          'billingMonth',
          'readingDate',
          'previousReading',
          'currentReading',
          'unitsConsumed',
          'rateId',
          'rateEffectiveFrom',
          'pricePerUnitMinor',
          'amountMinor',
          'notes',
          'currency',
          'status',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'readingId',
          'meterAssignmentId',
          'meterId',
          'meterCode',
          'roomId',
          'roomCode',
          'propertyId',
          'propertyCode',
          'billingMonth',
          'readingDate',
          'previousReading',
          'currentReading',
          'unitsConsumed',
          'rateId',
          'rateEffectiveFrom',
          'pricePerUnitMinor',
          'amountMinor',
          'notes',
          'currency',
          'status',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy',
          'tenantAssignmentId',
          'tenantId',
          'tenantCode',
          'tenantName',
          'tenantRoomNumber',
          'tenantFloorName'
        ])
        && validElectricityTenantSnapshot(data)
        && data.readingId == billId
        && data.meterAssignmentId is string
        && data.meterId is string
        && data.meterCode is string
        && validElectricityMonth(data.billingMonth)
        && (
          billId == data.meterAssignmentId + '__' + data.billingMonth
          || billId == data.meterAssignmentId + '__' + data.readingDate
        )
        && data.currency == 'BDT'
        && data.status == 'issued'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid
        && existsAfter(readingPath)
        && getAfter(readingPath).data.meterAssignmentId == data.meterAssignmentId
        && getAfter(readingPath).data.meterId == data.meterId
        && getAfter(readingPath).data.meterCode == data.meterCode
        && getAfter(readingPath).data.roomId == data.roomId
        && getAfter(readingPath).data.roomCode == data.roomCode
        && getAfter(readingPath).data.propertyId == data.propertyId
        && getAfter(readingPath).data.propertyCode == data.propertyCode
        && getAfter(readingPath).data.billingMonth == data.billingMonth
        && getAfter(readingPath).data.readingDate == data.readingDate
        && getAfter(readingPath).data.previousReading == data.previousReading
        && getAfter(readingPath).data.currentReading == data.currentReading
        && getAfter(readingPath).data.unitsConsumed == data.unitsConsumed
        && getAfter(readingPath).data.rateId == data.rateId
        && getAfter(readingPath).data.rateEffectiveFrom == data.rateEffectiveFrom
        && getAfter(readingPath).data.pricePerUnitMinor == data.pricePerUnitMinor
        && getAfter(readingPath).data.amountMinor == data.amountMinor
        && getAfter(readingPath).data.notes == data.notes
        && (('tenantAssignmentId' in data) == ('tenantAssignmentId' in getAfter(readingPath).data))
        && (
          !('tenantAssignmentId' in data)
          || (
            getAfter(readingPath).data.tenantAssignmentId == data.tenantAssignmentId
            && getAfter(readingPath).data.tenantId == data.tenantId
            && getAfter(readingPath).data.tenantCode == data.tenantCode
            && getAfter(readingPath).data.tenantName == data.tenantName
            && getAfter(readingPath).data.tenantRoomNumber == data.tenantRoomNumber
            && getAfter(readingPath).data.tenantFloorName == data.tenantFloorName
          )
        );
    }

    match /users/{userId}/electricityBills/{billId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validElectricityBill(userId, billId, request.resource.data)
        && createdByCurrentActor(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    // ==================================================
    // 28. LATEST ELECTRICITY READING STATE
    // ==================================================

    function validElectricityReadingState(userId, assignmentId, data) {
      let readingPath =
        /databases/$(database)/documents/users/$(userId)/electricityReadings/$(data.lastReadingId);
      let billPath =
        /databases/$(database)/documents/users/$(userId)/electricityBills/$(data.lastReadingId);

      return data.keys().hasAll([
          'meterAssignmentId',
          'lastReadingId',
          'lastReadingDate',
          'lastReadingValue',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'meterAssignmentId',
          'lastReadingId',
          'lastReadingDate',
          'lastReadingValue',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.meterAssignmentId == assignmentId
        && data.lastReadingId is string
        && data.lastReadingId.size() > 0
        && validElectricityDate(data.lastReadingDate)
        && validElectricityNumber(data.lastReadingValue)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid
        && existsAfter(readingPath)
        && getAfter(readingPath).data.meterAssignmentId == assignmentId
        && getAfter(readingPath).data.readingDate == data.lastReadingDate
        && getAfter(readingPath).data.currentReading == data.lastReadingValue
        && existsAfter(billPath)
        && getAfter(billPath).data.readingId == data.lastReadingId;
    }

    match /users/{userId}/electricityReadingState/{assignmentId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validElectricityReadingState(userId, assignmentId, request.resource.data)
        && createdByCurrentActor(request.resource.data);
      allow update: if isOwner(userId)
        && validElectricityReadingState(userId, assignmentId, request.resource.data)
        && request.resource.data.meterAssignmentId == resource.data.meterAssignmentId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.lastReadingDate > resource.data.lastReadingDate;
      allow delete: if false;
    }

    // ==================================================
    // ==================================================
    // 30. PAYMENT RECORDS (IMMUTABLE RECEIPTS)
    // ==================================================

    function validPaymentDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validPaymentMonth(value) {
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function validPaymentAllocation(data) {
      return data is map
        && data.keys().hasAll([
          'billType', 'billId', 'billingMonth', 'referenceDate',
          'amountMinor', 'billAmountMinor', 'tenantAssignmentId',
          'tenantId', 'tenantCode', 'tenantName', 'roomId', 'roomCode',
          'roomNumber', 'floorName', 'propertyId', 'propertyCode'
        ])
        && data.keys().hasOnly([
          'billType', 'billId', 'billingMonth', 'referenceDate',
          'amountMinor', 'billAmountMinor', 'tenantAssignmentId',
          'tenantId', 'tenantCode', 'tenantName', 'roomId', 'roomCode',
          'roomNumber', 'floorName', 'propertyId', 'propertyCode'
        ])
        && data.billType in ['rent', 'electricity']
        && data.billId is string
        && data.billId.size() > 0
        && data.billId.size() <= 500
        && validPaymentMonth(data.billingMonth)
        && validPaymentDate(data.referenceDate)
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.billAmountMinor is int
        && data.billAmountMinor > 0
        && data.amountMinor <= data.billAmountMinor
        && data.tenantAssignmentId is string
        && data.tenantAssignmentId.size() > 0
        && data.tenantId is string
        && data.tenantId.size() > 0
        && data.tenantCode is string
        && data.tenantCode.matches('^T[0-9]{5}[A-Z]$')
        && data.tenantName is string
        && data.tenantName.size() >= 2
        && data.tenantName.size() <= 100
        && data.roomId is string
        && data.roomId.size() > 0
        && data.roomCode is string
        && data.roomCode.matches('^R[0-9]{4}$')
        && data.roomNumber is string
        && data.roomNumber.size() >= 1
        && data.roomNumber.size() <= 30
        && data.floorName is string
        && data.floorName.size() >= 1
        && data.floorName.size() <= 80
        && data.propertyId is string
        && data.propertyId.size() > 0
        && data.propertyCode is string
        && data.propertyCode.matches('^P[0-9]{2}$');
    }

    function paymentCreditLinkedAfter(userId, paymentId, data) {
      let creditPath =
        /databases/$(database)/documents/users/$(userId)/tenantCredits/$(data.tenantId);

      return existsAfter(creditPath)
        && getAfter(creditPath).data.tenantId == data.tenantId
        && getAfter(creditPath).data.lastTransactionType == 'payment'
        && getAfter(creditPath).data.lastTransactionId == paymentId
        && getAfter(creditPath).data.lastTransactionAmountMinor == data.advanceAddedMinor
        && getAfter(creditPath).data.creditMinor >= data.advanceAddedMinor
        && data.creditUpdate.tenantId == data.tenantId
        && data.creditUpdate.amountMinor == data.advanceAddedMinor;
    }

    function paymentTransactionReferenceExistsAfter(userId, paymentId, data) {
      let referencePath =
        /databases/$(database)/documents/users/$(userId)/transactionReferences/$(data.transactionId);
      return existsAfter(referencePath)
        && getAfter(referencePath).data.paymentId == paymentId
        && getAfter(referencePath).data.transactionId == data.transactionId;
    }

    function validTransactionReference(userId, transactionId, data) {
      return data.keys().hasAll(['paymentId', 'transactionId', 'createdAt'])
        && data.keys().hasOnly(['paymentId', 'transactionId', 'createdAt'])
        && transactionId.matches('^[A-Z0-9]{10}$')
        && data.transactionId == transactionId
        && data.paymentId is string
        && data.paymentId.size() > 0
        && data.createdAt is timestamp
        && existsAfter(
          /databases/$(database)/documents/users/$(userId)/payments/$(data.paymentId)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/payments/$(data.paymentId)
        ).data.transactionId == transactionId;
    }

    function paymentOpeningBalanceLinkedAfter(userId, paymentId, data) {
      let openingBalancePath =
        /databases/$(database)/documents/users/$(userId)/openingBalances/$(data.tenantId);
      return data.openingBalanceAllocationMinor == 0 || (
        existsAfter(openingBalancePath)
        && getAfter(openingBalancePath).data.tenantId == data.tenantId
        && getAfter(openingBalancePath).data.lastTransactionType == 'payment'
        && getAfter(openingBalancePath).data.lastTransactionId == paymentId
        && getAfter(openingBalancePath).data.lastTransactionAmountMinor == data.openingBalanceAllocationMinor
      );
    }

    function validPaymentRecord(userId, paymentId, data) {
      let tenantPath =
        /databases/$(database)/documents/users/$(userId)/tenants/$(data.tenantId);

      return exists(tenantPath)
        && get(tenantPath).data.tenantCode == data.tenantCode
        && get(tenantPath).data.fullName == data.tenantName
        && data.keys().hasAll([
          'receiptNumber', 'transactionId', 'tenantId', 'tenantCode', 'tenantName',
          'paidOn', 'method', 'reference', 'notes', 'amountMinor',
          'allocatedAmountMinor', 'advanceAddedMinor', 'openingBalanceAllocationMinor',
          'outstandingBeforeMinor', 'outstandingAfterMinor', 'creditUpdate',
          'currency', 'status', 'allocations', 'balanceUpdates',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'receiptNumber', 'transactionId', 'tenantId', 'tenantCode', 'tenantName',
          'paidOn', 'method', 'reference', 'notes', 'amountMinor',
          'allocatedAmountMinor', 'advanceAddedMinor', 'openingBalanceAllocationMinor',
          'outstandingBeforeMinor', 'outstandingAfterMinor', 'creditUpdate',
          'currency', 'status', 'allocations', 'balanceUpdates',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.receiptNumber == 'PAY-' + paymentId
        && data.transactionId is string
        && data.transactionId.matches('^[A-Z0-9]{10}$')
        && paymentTransactionReferenceExistsAfter(userId, paymentId, data)
        && data.tenantId is string
        && data.tenantId.size() > 0
        && data.tenantCode is string
        && data.tenantCode.matches('^T[0-9]{5}[A-Z]$')
        && data.tenantName is string
        && data.tenantName.size() >= 2
        && data.tenantName.size() <= 100
        && validPaymentDate(data.paidOn)
        && data.method in ['cash', 'bank_transfer', 'mobile_banking', 'cheque', 'other']
        && data.reference is string
        && data.reference.size() <= 120
        && data.notes is string
        && data.notes.size() <= 1000
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.amountMinor <= 10000000000000
        && data.allocatedAmountMinor is int
        && data.allocatedAmountMinor >= 0
        && data.advanceAddedMinor is int
        && data.advanceAddedMinor >= 0
        && data.openingBalanceAllocationMinor is int
        && data.openingBalanceAllocationMinor >= 0
        && data.openingBalanceAllocationMinor <= data.allocatedAmountMinor
        && data.allocatedAmountMinor + data.advanceAddedMinor == data.amountMinor
        && data.outstandingBeforeMinor is int
        && data.outstandingBeforeMinor >= data.allocatedAmountMinor
        && data.outstandingBeforeMinor <= 10000000000000
        && data.outstandingAfterMinor is int
        && data.outstandingAfterMinor >= 0
        && data.outstandingAfterMinor == data.outstandingBeforeMinor - data.allocatedAmountMinor
        && data.creditUpdate is map
        && data.creditUpdate.keys().hasAll(['tenantId', 'amountMinor'])
        && data.creditUpdate.keys().hasOnly(['tenantId', 'amountMinor'])
        && data.creditUpdate.tenantId == data.tenantId
        && data.creditUpdate.amountMinor == data.advanceAddedMinor
        && data.currency == 'BDT'
        && data.status == 'posted'
        && data.allocations is list
        && data.allocations.size() <= 20
        && data.balanceUpdates is list
        && data.balanceUpdates.size() == data.allocations.size()
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid
        && paymentOpeningBalanceLinkedAfter(userId, paymentId, data)
        && (data.advanceAddedMinor == 0 || paymentCreditLinkedAfter(userId, paymentId, data));
    }

    // ==================================================
    // 31. ATOMIC BILL BALANCES
    // ==================================================

    function validPaymentBillBalance(balanceId, data) {
      return data.keys().hasAll([
          'billType', 'billId', 'billingMonth', 'tenantAssignmentId',
          'tenantId', 'tenantCode', 'tenantName', 'roomId', 'roomCode',
          'roomNumber', 'floorName', 'propertyId', 'propertyCode',
          'originalAmountMinor', 'paidAmountMinor', 'outstandingMinor',
          'lastTransactionType', 'lastTransactionId',
          'lastTransactionAmountMinor', 'createdAt', 'updatedAt',
          'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'billType', 'billId', 'billingMonth', 'tenantAssignmentId',
          'tenantId', 'tenantCode', 'tenantName', 'roomId', 'roomCode',
          'roomNumber', 'floorName', 'propertyId', 'propertyCode',
          'originalAmountMinor', 'paidAmountMinor', 'outstandingMinor',
          'lastTransactionType', 'lastTransactionId',
          'lastTransactionAmountMinor', 'createdAt', 'updatedAt',
          'createdBy', 'updatedBy'
        ])
        && data.billType in ['rent', 'electricity']
        && data.billId is string
        && data.billId.size() > 0
        && balanceId == data.billType + '__' + data.billId
        && validPaymentMonth(data.billingMonth)
        && data.tenantAssignmentId is string
        && data.tenantAssignmentId.size() > 0
        && data.tenantId is string
        && data.tenantId.size() > 0
        && data.tenantCode is string
        && data.tenantCode.matches('^T[0-9]{5}[A-Z]$')
        && data.tenantName is string
        && data.tenantName.size() >= 2
        && data.tenantName.size() <= 100
        && data.roomId is string
        && data.roomId.size() > 0
        && data.roomCode is string
        && data.roomCode.matches('^R[0-9]{4}$')
        && data.roomNumber is string
        && data.roomNumber.size() >= 1
        && data.roomNumber.size() <= 30
        && data.floorName is string
        && data.floorName.size() >= 1
        && data.floorName.size() <= 80
        && data.propertyId is string
        && data.propertyId.size() > 0
        && data.propertyCode is string
        && data.propertyCode.matches('^P[0-9]{2}$')
        && data.originalAmountMinor is int
        && data.originalAmountMinor > 0
        && data.originalAmountMinor <= 10000000000000
        && data.paidAmountMinor is int
        && data.paidAmountMinor >= 0
        && data.paidAmountMinor <= data.originalAmountMinor
        && data.outstandingMinor is int
        && data.outstandingMinor >= 0
        && data.paidAmountMinor + data.outstandingMinor == data.originalAmountMinor
        && data.lastTransactionType in ['payment', 'credit_application']
        && data.lastTransactionId is string
        && data.lastTransactionId.size() > 0
        && data.lastTransactionAmountMinor is int
        && data.lastTransactionAmountMinor > 0
        && data.lastTransactionAmountMinor <= data.originalAmountMinor
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid;
    }

    function paymentBalanceLinkedAfter(userId, data) {
      let paymentPath =
        /databases/$(database)/documents/users/$(userId)/payments/$(data.lastTransactionId);
      let creditApplicationPath =
        /databases/$(database)/documents/users/$(userId)/creditApplications/$(data.lastTransactionId);

      return (
        data.lastTransactionType == 'payment'
        && existsAfter(paymentPath)
        && getAfter(paymentPath).data.tenantId == data.tenantId
        && getAfter(paymentPath).data.balanceUpdates is list
        && getAfter(paymentPath).data.balanceUpdates.hasAny([
          {
            'billType': data.billType,
            'billId': data.billId,
            'amountMinor': data.lastTransactionAmountMinor
          }
        ])
      ) || (
        data.lastTransactionType == 'credit_application'
        && existsAfter(creditApplicationPath)
        && getAfter(creditApplicationPath).data.tenantId == data.tenantId
        && getAfter(creditApplicationPath).data.billUpdates is list
        && getAfter(creditApplicationPath).data.billUpdates.hasAny([
          {
            'billType': data.billType,
            'billId': data.billId,
            'amountMinor': data.lastTransactionAmountMinor
          }
        ])
      );
    }

    match /users/{userId}/transactionReferences/{transactionId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validTransactionReference(userId, transactionId, request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId}/payments/{paymentId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validPaymentRecord(userId, paymentId, request.resource.data)
        && createdByCurrentActor(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId}/billBalances/{balanceId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validPaymentBillBalance(balanceId, request.resource.data)
        && createdByCurrentActor(request.resource.data)
        && request.resource.data.paidAmountMinor == request.resource.data.lastTransactionAmountMinor
        && paymentBalanceLinkedAfter(userId, request.resource.data);

      allow update: if isOwner(userId)
        && validPaymentBillBalance(balanceId, request.resource.data)
        && request.resource.data.billType == resource.data.billType
        && request.resource.data.billId == resource.data.billId
        && request.resource.data.billingMonth == resource.data.billingMonth
        && request.resource.data.tenantAssignmentId == resource.data.tenantAssignmentId
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.tenantCode == resource.data.tenantCode
        && request.resource.data.tenantName == resource.data.tenantName
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.roomCode == resource.data.roomCode
        && request.resource.data.roomNumber == resource.data.roomNumber
        && request.resource.data.floorName == resource.data.floorName
        && request.resource.data.propertyId == resource.data.propertyId
        && request.resource.data.propertyCode == resource.data.propertyCode
        && request.resource.data.originalAmountMinor == resource.data.originalAmountMinor
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.lastTransactionAmountMinor <= resource.data.outstandingMinor
        && request.resource.data.paidAmountMinor == resource.data.paidAmountMinor + request.resource.data.lastTransactionAmountMinor
        && request.resource.data.outstandingMinor == resource.data.outstandingMinor - request.resource.data.lastTransactionAmountMinor
        && request.resource.data.lastTransactionId != resource.data.lastTransactionId
        && paymentBalanceLinkedAfter(userId, request.resource.data);

      allow delete: if false;
    }

    // ==================================================
    // 32. TENANT ADVANCE CREDIT
    // ==================================================

    function validTenantCredit(tenantId, data) {
      return data.keys().hasAll([
          'tenantId', 'tenantCode', 'tenantName', 'creditMinor',
          'lastTransactionType', 'lastTransactionId', 'lastTransactionAmountMinor',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'tenantId', 'tenantCode', 'tenantName', 'creditMinor',
          'lastTransactionType', 'lastTransactionId', 'lastTransactionAmountMinor',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.tenantId == tenantId
        && data.tenantCode is string
        && data.tenantCode.matches('^T[0-9]{5}[A-Z]$')
        && data.tenantName is string
        && data.tenantName.size() >= 2
        && data.tenantName.size() <= 100
        && data.creditMinor is int
        && data.creditMinor >= 0
        && data.creditMinor <= 10000000000000
        && data.lastTransactionType in ['payment', 'credit_application']
        && data.lastTransactionId is string
        && data.lastTransactionId.size() > 0
        && data.lastTransactionAmountMinor is int
        && data.lastTransactionAmountMinor > 0
        && data.lastTransactionAmountMinor <= 10000000000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid;
    }

    function tenantCreditLinkedAfter(userId, tenantId, data) {
      let paymentPath =
        /databases/$(database)/documents/users/$(userId)/payments/$(data.lastTransactionId);
      let creditApplicationPath =
        /databases/$(database)/documents/users/$(userId)/creditApplications/$(data.lastTransactionId);
      let openingBalanceCreditApplicationPath =
        /databases/$(database)/documents/users/$(userId)/openingBalanceCreditApplications/$(data.lastTransactionId);

      return (
        data.lastTransactionType == 'payment'
        && existsAfter(paymentPath)
        && getAfter(paymentPath).data.tenantId == tenantId
        && getAfter(paymentPath).data.advanceAddedMinor == data.lastTransactionAmountMinor
        && getAfter(paymentPath).data.creditUpdate.tenantId == tenantId
        && getAfter(paymentPath).data.creditUpdate.amountMinor == data.lastTransactionAmountMinor
      ) || (
        data.lastTransactionType == 'credit_application'
        && existsAfter(creditApplicationPath)
        && getAfter(creditApplicationPath).data.tenantId == tenantId
        && getAfter(creditApplicationPath).data.amountMinor == data.lastTransactionAmountMinor
        && getAfter(creditApplicationPath).data.tenantCreditUpdate.tenantId == tenantId
        && getAfter(creditApplicationPath).data.tenantCreditUpdate.amountMinor == data.lastTransactionAmountMinor
      ) || (
        data.lastTransactionType == 'credit_application'
        && existsAfter(openingBalanceCreditApplicationPath)
        && getAfter(openingBalanceCreditApplicationPath).data.tenantId == tenantId
        && getAfter(openingBalanceCreditApplicationPath).data.amountMinor == data.lastTransactionAmountMinor
        && getAfter(openingBalanceCreditApplicationPath).data.tenantCreditUpdate.tenantId == tenantId
        && getAfter(openingBalanceCreditApplicationPath).data.tenantCreditUpdate.amountMinor == data.lastTransactionAmountMinor
      );
    }

    match /users/{userId}/tenantCredits/{tenantId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validTenantCredit(tenantId, request.resource.data)
        && createdByCurrentActor(request.resource.data)
        && request.resource.data.lastTransactionType == 'payment'
        && request.resource.data.creditMinor == request.resource.data.lastTransactionAmountMinor
        && tenantCreditLinkedAfter(userId, tenantId, request.resource.data);

      allow update: if isOwner(userId)
        && validTenantCredit(tenantId, request.resource.data)
        && request.resource.data.tenantCode == resource.data.tenantCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          (
            request.resource.data.lastTransactionType == 'payment'
            && request.resource.data.creditMinor == resource.data.creditMinor + request.resource.data.lastTransactionAmountMinor
          ) || (
            request.resource.data.lastTransactionType == 'credit_application'
            && resource.data.creditMinor >= request.resource.data.lastTransactionAmountMinor
            && request.resource.data.creditMinor == resource.data.creditMinor - request.resource.data.lastTransactionAmountMinor
          )
        )
        && tenantCreditLinkedAfter(userId, tenantId, request.resource.data);

      allow delete: if false;
    }

    // ==================================================
    // 33. IMMUTABLE ADVANCE APPLICATIONS
    // ==================================================

    function validCreditApplicationReferenceLinkedAfter(userId, applicationId, data) {
      return data.applicationNumber is string
        && data.applicationNumber.matches('^AP-[A-Za-z0-9]{7}$')
        && existsAfter(
          /databases/$(database)/documents/users/$(userId)/creditApplicationReferenceIndex/$(data.applicationNumber)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/creditApplicationReferenceIndex/$(data.applicationNumber)
        ).data.applicationId == applicationId
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/creditApplicationReferenceIndex/$(data.applicationNumber)
        ).data.applicationNumber == data.applicationNumber
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/creditApplicationReferenceIndex/$(data.applicationNumber)
        ).data.createdBy == request.auth.uid;
    }

    function validCreditApplication(userId, applicationId, data) {
      return data.keys().hasAll([
          'applicationNumber', 'tenantId', 'tenantCode', 'tenantName',
          'allocation', 'billUpdates', 'tenantCreditUpdate', 'amountMinor',
          'currency', 'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'applicationNumber', 'tenantId', 'tenantCode', 'tenantName',
          'allocation', 'billUpdates', 'tenantCreditUpdate', 'amountMinor',
          'currency', 'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && (
          data.applicationNumber == 'ADV-' + applicationId
          || validCreditApplicationReferenceLinkedAfter(userId, applicationId, data)
        )
        && data.tenantId is string
        && data.tenantId.size() > 0
        && data.tenantCode is string
        && data.tenantCode.matches('^T[0-9]{5}[A-Z]$')
        && data.tenantName is string
        && data.tenantName.size() >= 2
        && data.tenantName.size() <= 100
        && validPaymentAllocation(data.allocation)
        && data.allocation.tenantId == data.tenantId
        && data.allocation.tenantCode == data.tenantCode
        && data.allocation.tenantName == data.tenantName
        && data.amountMinor is int
        && data.amountMinor == data.allocation.amountMinor
        && data.billUpdates is list
        && data.billUpdates.size() == 1
        && data.billUpdates[0].billType == data.allocation.billType
        && data.billUpdates[0].billId == data.allocation.billId
        && data.billUpdates[0].amountMinor == data.amountMinor
        && data.tenantCreditUpdate is map
        && data.tenantCreditUpdate.keys().hasAll(['tenantId', 'amountMinor'])
        && data.tenantCreditUpdate.keys().hasOnly(['tenantId', 'amountMinor'])
        && data.tenantCreditUpdate.tenantId == data.tenantId
        && data.tenantCreditUpdate.amountMinor == data.amountMinor
        && data.currency == 'BDT'
        && data.status == 'posted'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid;
    }

    function creditApplicationAtomicAfter(userId, applicationId, data) {
      let creditPath =
        /databases/$(database)/documents/users/$(userId)/tenantCredits/$(data.tenantId);
      let balanceId = data.allocation.billType + '__' + data.allocation.billId;
      let balancePath =
        /databases/$(database)/documents/users/$(userId)/billBalances/$(balanceId);

      return exists(creditPath)
        && existsAfter(creditPath)
        && get(creditPath).data.creditMinor >= data.amountMinor
        && getAfter(creditPath).data.creditMinor == get(creditPath).data.creditMinor - data.amountMinor
        && getAfter(creditPath).data.lastTransactionType == 'credit_application'
        && getAfter(creditPath).data.lastTransactionId == applicationId
        && getAfter(creditPath).data.lastTransactionAmountMinor == data.amountMinor
        && existsAfter(balancePath)
        && getAfter(balancePath).data.lastTransactionType == 'credit_application'
        && getAfter(balancePath).data.lastTransactionId == applicationId
        && getAfter(balancePath).data.lastTransactionAmountMinor == data.amountMinor
        && getAfter(balancePath).data.billType == data.allocation.billType
        && getAfter(balancePath).data.billId == data.allocation.billId
        && getAfter(balancePath).data.tenantId == data.tenantId;
    }

    match /users/{userId}/creditApplications/{applicationId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validCreditApplication(userId, applicationId, request.resource.data)
        && createdByCurrentActor(request.resource.data)
        && creditApplicationAtomicAfter(userId, applicationId, request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    function validCreditApplicationReferenceIndex(userId, referenceCode, data) {
      return data.keys().hasAll(['applicationId', 'applicationNumber', 'createdAt', 'createdBy'])
        && data.keys().hasOnly(['applicationId', 'applicationNumber', 'createdAt', 'createdBy'])
        && referenceCode.matches('^AP-[A-Za-z0-9]{7}$')
        && data.applicationId is string
        && data.applicationId.size() > 0
        && data.applicationNumber == referenceCode
        && data.createdAt is timestamp
        && data.createdBy == request.auth.uid
        && existsAfter(
          /databases/$(database)/documents/users/$(userId)/creditApplications/$(data.applicationId)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/creditApplications/$(data.applicationId)
        ).data.applicationNumber == referenceCode
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/creditApplications/$(data.applicationId)
        ).data.createdBy == request.auth.uid;
    }

    match /users/{userId}/creditApplicationReferenceIndex/{referenceCode} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validCreditApplicationReferenceIndex(userId, referenceCode, request.resource.data)
        && createdByCurrentActor(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    // ==================================================
    // 34. OWNER NOTES AND CHECKLIST ITEMS
    // ==================================================

    function validNote(data) {
      return data.keys().hasAll([
          'title', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'title', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid;
    }

    function validNoteTask(data) {
      return data.keys().hasAll([
          'noteId', 'text', 'order', 'completedAt', 'expiresAt',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'noteId', 'text', 'order', 'completedAt', 'expiresAt',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.noteId is string
        && data.noteId.size() > 0
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 1000
        && data.order is int
        && data.order >= 0
        && (data.completedAt == null || data.completedAt is timestamp)
        && (data.expiresAt == null || data.expiresAt is timestamp)
        && ((data.completedAt == null && data.expiresAt == null)
          || (data.completedAt is timestamp && data.expiresAt is timestamp
            && data.expiresAt > data.completedAt))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid;
    }

    match /users/{userId}/notes/{noteId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validNote(request.resource.data)
        && createdByCurrentActor(request.resource.data);
      allow update: if isOwner(userId)
        && validNote(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isOwner(userId);
    }

    function noteTaskParentExistsAfter(userId, noteId) {
      let notePath = /databases/$(database)/documents/users/$(userId)/notes/$(noteId);
      return existsAfter(notePath);
    }

    match /users/{userId}/noteTasks/{taskId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validNoteTask(request.resource.data)
        && createdByCurrentActor(request.resource.data)
        && noteTaskParentExistsAfter(userId, request.resource.data.noteId);
      allow update: if isOwner(userId)
        && validNoteTask(request.resource.data)
        && request.resource.data.noteId == resource.data.noteId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && noteTaskParentExistsAfter(userId, resource.data.noteId);
      allow delete: if isOwner(userId);
    }

    // ==================================================
    // 35. TENANT OPENING BALANCES
    // ==================================================

    function validOpeningBalance(tenantId, data) {
      return data.keys().hasAll([
          'tenantId', 'tenantCode', 'tenantName', 'effectiveDate',
          'originalAmountMinor', 'adjustedAmountMinor', 'paidAmountMinor',
          'outstandingMinor', 'note', 'lastTransactionType', 'lastTransactionId',
          'lastTransactionAmountMinor', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'tenantId', 'tenantCode', 'tenantName', 'effectiveDate',
          'originalAmountMinor', 'adjustedAmountMinor', 'paidAmountMinor',
          'outstandingMinor', 'note', 'lastTransactionType', 'lastTransactionId',
          'lastTransactionAmountMinor', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.tenantId == tenantId
        && data.tenantCode is string
        && data.tenantCode.matches('^T[0-9]{5}[A-Z]$')
        && data.tenantName is string
        && data.tenantName.size() >= 2
        && data.tenantName.size() <= 100
        && validPaymentDate(data.effectiveDate)
        && data.originalAmountMinor is int
        && data.originalAmountMinor > 0
        && data.originalAmountMinor <= 10000000000000
        && data.adjustedAmountMinor is int
        && data.adjustedAmountMinor >= -10000000000000
        && data.paidAmountMinor is int
        && data.paidAmountMinor >= 0
        && data.outstandingMinor is int
        && data.outstandingMinor >= 0
        && data.outstandingMinor <= 10000000000000
        && data.originalAmountMinor + data.adjustedAmountMinor <= 10000000000000
        && data.originalAmountMinor + data.adjustedAmountMinor >= data.paidAmountMinor
        && data.outstandingMinor == data.originalAmountMinor + data.adjustedAmountMinor - data.paidAmountMinor
        && data.note is string
        && data.note.size() <= 1000
        && data.lastTransactionType in ['opening_balance', 'payment', 'credit_application', 'adjustment']
        && data.lastTransactionId is string
        && data.lastTransactionId.size() > 0
        && data.lastTransactionAmountMinor is int
        && data.lastTransactionAmountMinor > 0
        && data.lastTransactionAmountMinor <= 10000000000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid;
    }

    function openingBalanceLinkedAfter(userId, tenantId, data) {
      let paymentPath =
        /databases/$(database)/documents/users/$(userId)/payments/$(data.lastTransactionId);
      let openingCreditPath =
        /databases/$(database)/documents/users/$(userId)/openingBalanceCreditApplications/$(data.lastTransactionId);
      let adjustmentPath =
        /databases/$(database)/documents/users/$(userId)/openingBalanceAdjustments/$(data.lastTransactionId);

      return (
        data.lastTransactionType == 'payment'
        && existsAfter(paymentPath)
        && getAfter(paymentPath).data.tenantId == tenantId
        && getAfter(paymentPath).data.openingBalanceAllocationMinor == data.lastTransactionAmountMinor
      ) || (
        data.lastTransactionType == 'credit_application'
        && existsAfter(openingCreditPath)
        && getAfter(openingCreditPath).data.tenantId == tenantId
        && getAfter(openingCreditPath).data.amountMinor == data.lastTransactionAmountMinor
      ) || (
        data.lastTransactionType == 'adjustment'
        && existsAfter(adjustmentPath)
        && getAfter(adjustmentPath).data.tenantId == tenantId
        && getAfter(adjustmentPath).data.amountMinor == data.lastTransactionAmountMinor
        && getAfter(adjustmentPath).data.afterOutstandingMinor == data.outstandingMinor
      );
    }

    match /users/{userId}/openingBalances/{tenantId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validOpeningBalance(tenantId, request.resource.data)
        && createdByCurrentActor(request.resource.data)
        && request.resource.data.lastTransactionType == 'opening_balance'
        && request.resource.data.lastTransactionId == tenantId
        && request.resource.data.adjustedAmountMinor == 0
        && request.resource.data.paidAmountMinor == 0
        && request.resource.data.outstandingMinor == request.resource.data.originalAmountMinor
        && request.resource.data.lastTransactionAmountMinor == request.resource.data.originalAmountMinor
        && exists(/databases/$(database)/documents/users/$(userId)/tenants/$(tenantId))
        && get(/databases/$(database)/documents/users/$(userId)/tenants/$(tenantId)).data.tenantCode == request.resource.data.tenantCode
        && get(/databases/$(database)/documents/users/$(userId)/tenants/$(tenantId)).data.fullName == request.resource.data.tenantName;

      allow update: if isOwner(userId)
        && validOpeningBalance(tenantId, request.resource.data)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.tenantCode == resource.data.tenantCode
        && request.resource.data.tenantName == resource.data.tenantName
        && request.resource.data.effectiveDate == resource.data.effectiveDate
        && request.resource.data.originalAmountMinor == resource.data.originalAmountMinor
        && request.resource.data.note == resource.data.note
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.lastTransactionId != resource.data.lastTransactionId
        && (
          (
            request.resource.data.lastTransactionType == 'payment'
            && request.resource.data.adjustedAmountMinor == resource.data.adjustedAmountMinor
            && request.resource.data.paidAmountMinor == resource.data.paidAmountMinor + request.resource.data.lastTransactionAmountMinor
            && request.resource.data.outstandingMinor == resource.data.outstandingMinor - request.resource.data.lastTransactionAmountMinor
            && request.resource.data.lastTransactionAmountMinor <= resource.data.outstandingMinor
          ) || (
            request.resource.data.lastTransactionType == 'credit_application'
            && request.resource.data.adjustedAmountMinor == resource.data.adjustedAmountMinor
            && request.resource.data.paidAmountMinor == resource.data.paidAmountMinor + request.resource.data.lastTransactionAmountMinor
            && request.resource.data.outstandingMinor == resource.data.outstandingMinor - request.resource.data.lastTransactionAmountMinor
            && request.resource.data.lastTransactionAmountMinor <= resource.data.outstandingMinor
          ) || (
            request.resource.data.lastTransactionType == 'adjustment'
            && request.resource.data.paidAmountMinor == resource.data.paidAmountMinor
            && request.resource.data.lastTransactionAmountMinor > 0
            && request.resource.data.outstandingMinor >= 0
            && (
              (
                getAfter(/databases/$(database)/documents/users/$(userId)/openingBalanceAdjustments/$(request.resource.data.lastTransactionId)).data.direction == 'increase'
                && request.resource.data.adjustedAmountMinor == resource.data.adjustedAmountMinor + request.resource.data.lastTransactionAmountMinor
                && request.resource.data.outstandingMinor == resource.data.outstandingMinor + request.resource.data.lastTransactionAmountMinor
              ) || (
                getAfter(/databases/$(database)/documents/users/$(userId)/openingBalanceAdjustments/$(request.resource.data.lastTransactionId)).data.direction == 'decrease'
                && request.resource.data.adjustedAmountMinor == resource.data.adjustedAmountMinor - request.resource.data.lastTransactionAmountMinor
                && request.resource.data.outstandingMinor == resource.data.outstandingMinor - request.resource.data.lastTransactionAmountMinor
              )
            )
          )
        )
        && openingBalanceLinkedAfter(userId, tenantId, request.resource.data);

      allow delete: if false;
    }

    function validOpeningBalanceAdjustment(adjustmentId, data) {
      return data.keys().hasAll([
          'adjustmentNumber', 'tenantId', 'tenantCode', 'tenantName', 'direction',
          'amountMinor', 'beforeOutstandingMinor', 'afterOutstandingMinor',
          'effectiveDate', 'note', 'createdAt', 'createdBy'
        ])
        && data.keys().hasOnly([
          'adjustmentNumber', 'tenantId', 'tenantCode', 'tenantName', 'direction',
          'amountMinor', 'beforeOutstandingMinor', 'afterOutstandingMinor',
          'effectiveDate', 'note', 'createdAt', 'createdBy'
        ])
        && data.adjustmentNumber == 'OBA-' + adjustmentId
        && data.tenantId is string
        && data.tenantCode is string
        && data.tenantCode.matches('^T[0-9]{5}[A-Z]$')
        && data.tenantName is string
        && data.tenantName.size() >= 2
        && data.tenantName.size() <= 100
        && data.direction in ['increase', 'decrease']
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.amountMinor <= 10000000000000
        && data.beforeOutstandingMinor is int
        && data.beforeOutstandingMinor >= 0
        && data.beforeOutstandingMinor <= 10000000000000
        && data.afterOutstandingMinor is int
        && data.afterOutstandingMinor >= 0
        && data.afterOutstandingMinor <= 10000000000000
        && ((data.direction == 'increase'
            && data.afterOutstandingMinor == data.beforeOutstandingMinor + data.amountMinor)
          || (data.direction == 'decrease'
            && data.beforeOutstandingMinor >= data.amountMinor
            && data.afterOutstandingMinor == data.beforeOutstandingMinor - data.amountMinor))
        && validPaymentDate(data.effectiveDate)
        && data.note is string
        && data.note.size() >= 1
        && data.note.size() <= 1000
        && data.createdAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0;
    }

    function openingBalanceAdjustmentLinkedAfter(userId, adjustmentId, data) {
      let openingPath =
        /databases/$(database)/documents/users/$(userId)/openingBalances/$(data.tenantId);
      return existsAfter(openingPath)
        && getAfter(openingPath).data.lastTransactionType == 'adjustment'
        && getAfter(openingPath).data.lastTransactionId == adjustmentId
        && getAfter(openingPath).data.lastTransactionAmountMinor == data.amountMinor
        && getAfter(openingPath).data.outstandingMinor == data.afterOutstandingMinor;
    }

    match /users/{userId}/openingBalanceAdjustments/{adjustmentId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validOpeningBalanceAdjustment(adjustmentId, request.resource.data)
        && createdByCurrentActor(request.resource.data)
        && openingBalanceAdjustmentLinkedAfter(userId, adjustmentId, request.resource.data);
      allow update, delete: if false;
    }

    function validOpeningBalanceCreditApplication(applicationId, data) {
      return data.keys().hasAll([
          'applicationNumber', 'tenantId', 'tenantCode', 'tenantName', 'amountMinor',
          'tenantCreditUpdate', 'currency', 'status', 'createdAt', 'updatedAt',
          'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'applicationNumber', 'tenantId', 'tenantCode', 'tenantName', 'amountMinor',
          'tenantCreditUpdate', 'currency', 'status', 'createdAt', 'updatedAt',
          'createdBy', 'updatedBy'
        ])
        && data.applicationNumber == 'OBC-' + applicationId
        && data.tenantId is string
        && data.tenantId.size() > 0
        && data.tenantCode is string
        && data.tenantCode.matches('^T[0-9]{5}[A-Z]$')
        && data.tenantName is string
        && data.tenantName.size() >= 2
        && data.tenantName.size() <= 100
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.amountMinor <= 10000000000000
        && data.tenantCreditUpdate is map
        && data.tenantCreditUpdate.keys().hasAll(['tenantId', 'amountMinor'])
        && data.tenantCreditUpdate.keys().hasOnly(['tenantId', 'amountMinor'])
        && data.tenantCreditUpdate.tenantId == data.tenantId
        && data.tenantCreditUpdate.amountMinor == data.amountMinor
        && data.currency == 'BDT'
        && data.status == 'posted'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid;
    }

    function openingBalanceCreditApplicationAtomicAfter(userId, applicationId, data) {
      let openingPath =
        /databases/$(database)/documents/users/$(userId)/openingBalances/$(data.tenantId);
      let creditPath =
        /databases/$(database)/documents/users/$(userId)/tenantCredits/$(data.tenantId);
      return existsAfter(openingPath)
        && getAfter(openingPath).data.tenantId == data.tenantId
        && getAfter(openingPath).data.tenantCode == data.tenantCode
        && getAfter(openingPath).data.tenantName == data.tenantName
        && getAfter(openingPath).data.lastTransactionType == 'credit_application'
        && getAfter(openingPath).data.lastTransactionId == applicationId
        && getAfter(openingPath).data.lastTransactionAmountMinor == data.amountMinor
        && getAfter(openingPath).data.outstandingMinor >= 0
        && exists(creditPath)
        && existsAfter(creditPath)
        && get(creditPath).data.creditMinor >= data.amountMinor
        && getAfter(creditPath).data.creditMinor == get(creditPath).data.creditMinor - data.amountMinor
        && getAfter(creditPath).data.lastTransactionType == 'credit_application'
        && getAfter(creditPath).data.lastTransactionId == applicationId
        && getAfter(creditPath).data.lastTransactionAmountMinor == data.amountMinor;
    }

    match /users/{userId}/openingBalanceCreditApplications/{applicationId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validOpeningBalanceCreditApplication(applicationId, request.resource.data)
        && createdByCurrentActor(request.resource.data)
        && openingBalanceCreditApplicationAtomicAfter(userId, applicationId, request.resource.data);
      allow update, delete: if false;
    }

    // ==================================================
    // 36. IMMUTABLE AUDIT EVENTS
    // ==================================================

    function validAuditEvent(data) {
      return data.keys().hasAll([
          'actorUid', 'action', 'entityType', 'entityId',
          'entityLabel', 'summary', 'occurredAt'
        ])
        && data.keys().hasOnly([
          'actorUid', 'action', 'entityType', 'entityId',
          'entityLabel', 'summary', 'occurredAt'
        ])
        && data.actorUid == request.auth.uid
        && data.action in [
          'created', 'updated', 'assigned', 'moved_out', 'replaced',
          'rate_added', 'rate_deleted', 'bills_generated', 'bill_issued',
          'payment_recorded', 'credit_applied',
          'opening_balance_added', 'opening_balance_adjusted',
          'invitation_created', 'invitation_accepted',
          'invitation_cancelled', 'member_revoked'
        ]
        && data.entityType in [
          'property', 'room', 'tenant', 'meter', 'tenant_assignment',
          'meter_assignment', 'rent_rate', 'rent_bills',
          'electricity_rate', 'electricity_bill', 'payment',
          'credit_application', 'opening_balance', 'member', 'invitation'
        ]
        && data.entityId is string
        && data.entityId.size() >= 1
        && data.entityId.size() <= 200
        && data.entityLabel is string
        && data.entityLabel.size() >= 1
        && data.entityLabel.size() <= 160
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 320
        && data.occurredAt is timestamp;
    }

    match /users/{userId}/auditEvents/{eventId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validAuditEvent(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

        // ==================================================
    // MANUAL BACKUP RESTORE SESSION
    // ==================================================
    function validWorkspaceSettings(data) {
      return data.keys().hasAll([
          'houseName', 'contractNumber', 'paymentContact', 'address',
          'supportEmail', 'statementFooter', 'createdAt', 'updatedAt',
          'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'houseName', 'contractNumber', 'paymentContact', 'address',
          'supportEmail', 'statementFooter', 'createdAt', 'updatedAt',
          'createdBy', 'updatedBy'
        ])
        && data.houseName is string
        && data.houseName.size() >= 1
        && data.houseName.size() <= 100
        && data.contractNumber is string
        && data.contractNumber.size() <= 60
        && data.paymentContact is string
        && data.paymentContact.size() <= 80
        && data.address is string
        && data.address.size() <= 500
        && data.supportEmail is string
        && data.supportEmail.size() <= 200
        && data.statementFooter is string
        && data.statementFooter.size() <= 250
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.updatedBy == request.auth.uid;
    }

    // Workspace settings are shared by active workspace members.
    // Existing settings cannot be deleted by the client.
    match /users/{userId}/settings/{settingsId} {
      allow read: if isOwner(userId) && settingsId == 'general';

      allow create: if isOwner(userId)
        && settingsId == 'general'
        && validWorkspaceSettings(request.resource.data)
        && createdByCurrentActor(request.resource.data);

      allow update: if isOwner(userId)
        && settingsId == 'general'
        && validWorkspaceSettings(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if false;
    }
    match /users/{userId}/system/restoreMode {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'active', 'ownerUid', 'sessionToken', 'expiresAt', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'active', 'ownerUid', 'sessionToken', 'expiresAt', 'createdAt'
        ])
        && request.resource.data.active == true
        && request.resource.data.ownerUid == userId
        && request.resource.data.sessionToken is string
        && request.resource.data.sessionToken.size() >= 32
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.createdAt is timestamp;
      allow delete: if isOwner(userId);
    }

    // Only a signed-in owner may create missing records inside their own UID
    // namespace while a short-lived restore session is active. Existing
    // collection validators continue to govern ordinary creates.
    match /users/{userId}/{collectionName}/{documentId} {
      allow create: if isOwner(userId)
        && isRestoreMode(userId)
        && collectionName in [
          'auditEvents', 'billBalances', 'creditApplications', 'creditApplicationReferenceIndex',
          'noteTasks', 'notes', 'openingBalanceAdjustments',
          'openingBalanceCreditApplications', 'openingBalances',
          'currentAssignmentByMeter', 'currentMeterByRoom',
          'currentRoomByTenant', 'currentTenantByRoom',
          'electricityBills', 'electricityRates', 'electricityReadings',
          'electricityReadingState', 'meterAssignments', 'meters',
          'payments', 'properties', 'propertyNameIndex', 'rentBills',
          'rentBillRoomMonthLocks', 'roomNameIndex', 'roomRentRateUsageLocks', 'roomRentRates', 'rooms', 'tenantAssignments',
          'settings', 'tenantCredits', 'tenants', 'transactionReferences', 'system'
        ];
    }
// 35. DENY EVERYTHING ELSE
    // ==================================================

    // No other client database access is granted.

  }
}

